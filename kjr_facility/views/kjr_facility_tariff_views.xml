<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_kjr_facility_tariff_list" model="ir.ui.view">
        <field name="name">kjr.facility.tariff.list</field>
        <field name="model">kjr.facility.tariff</field>
        <field name="arch" type="xml">
            <list string="Tarife" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="tariff_type"/>
                <field name="facility_id"/>
                <field name="price_per_person_night"/>
                <field name="meal_full"/>
                <!-- F1: Zusatzpositionen standardmäßig ausgeblendet, damit die
                     Tarifliste lesbar bleibt (über das Spaltenmenü einblendbar). -->
                <field name="weekday_price_per_person_night" optional="hide"/>
                <field name="weekday_min_nights" optional="hide"/>
                <field name="visitor_tax_per_person_night" optional="hide"/>
                <field name="final_cleaning_fee" optional="hide"/>
                <field name="tax_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_kjr_facility_tariff_form" model="ir.ui.view">
        <field name="name">kjr.facility.tariff.form</field>
        <field name="model">kjr.facility.tariff</field>
        <field name="arch" type="xml">
            <form string="Tarif">
                <sheet>
                    <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
                    <group>
                        <group string="Zuordnung">
                            <field name="tariff_type"/>
                            <field name="facility_id"/>
                            <field name="active"/>
                            <field name="tax_id"/>
                        </group>
                        <group string="Preise">
                            <field name="price_per_person_night"/>
                            <field name="price_flat_per_night"/>
                            <field name="meal_breakfast"/>
                            <field name="meal_half"/>
                            <field name="meal_full"/>
                        </group>
                        <!-- F1: Einmal- und Zusatzpositionen sowie der reduzierte
                             Mo–Fr-Satz. Berechnet wird das in der Buchung. -->
                        <group string="Zusatzpositionen und Wochentagstarif" name="extras" colspan="2">
                            <group>
                                <field name="visitor_tax_per_person_night"/>
                                <field name="final_cleaning_fee"/>
                            </group>
                            <group>
                                <field name="weekday_price_per_person_night"/>
                                <field name="weekday_min_nights"/>
                            </group>
                        </group>
                    </group>
                    <div class="alert alert-info" role="alert">
                        Der Fremdenverkehrsbeitrag wird je Nacht nur auf die Teilnehmenden
                        berechnet. Betreuende sind als Begleitpersonen befreit und werden
                        automatisch nicht mitgerechnet. Zusätzlich abgezogen wird die in der
                        Buchung erfasste Anzahl weiterer befreiter Teilnehmender (Einwohner
                        der Standortgemeinde, Kinder unter 7 Jahren, Schwerbehinderte) —
                        Betreuende dort bitte NICHT erneut eintragen. Die Endreinigung fällt
                        einmalig je Buchung an, nicht pro Nacht.
                    </div>
                    <div class="alert alert-warning" role="alert">
                        Steuerlich final zu prüfen: § 4 Nr. 23 UStG (Befreiung) bzw. § 68 Nr. 8 AO
                        (7 %, Zweckbetrieb) für Jugendgruppen, 19 % bei kommerzieller Nutzung.
                    </div>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_kjr_facility_tariff" model="ir.actions.act_window">
        <field name="name">Tarife</field>
        <field name="res_model">kjr.facility.tariff</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
