<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_kjr_booking_search" model="ir.ui.view">
        <field name="name">kjr.facility.booking.search</field>
        <field name="model">kjr.facility.booking</field>
        <field name="arch" type="xml">
            <search string="Buchungen">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="contact_person"/>
                <field name="facility_id"/>
                <filter string="Anfragen" name="draft" domain="[('state','=','draft')]"/>
                <filter string="Reserviert (vorgemerkt)" name="reserved" domain="[('state','=','reserved')]"/>
                <filter string="Gebucht" name="confirmed" domain="[('state','in',('confirmed','deposit','checked_in'))]"/>
                <filter string="Berechnet" name="invoiced" domain="[('state','=','invoiced')]"/>
                <filter string="Offen (Zahlung)" name="payment_open" domain="[('payment_status','in',('not_paid','partial'))]"/>
                <filter string="Aktuell/Zukünftig" name="upcoming" domain="[('check_out','&gt;=',context_today())]"/>
                <filter string="Schaden im Übergabeprotokoll" name="handover_damage"
                        domain="['|',('handover_in_damage','=',True),('handover_out_damage','=',True)]"/>
                <filter string="Abreiseprotokoll fehlt" name="handover_missing"
                        domain="[('state','in',('checked_in','invoiced','done')),('handover_out_date','=',False)]"/>
                <separator/>
                <filter string="Einrichtung" name="group_facility" context="{'group_by':'facility_id'}"/>
                <filter string="Status" name="group_state" context="{'group_by':'state'}"/>
                <filter string="Anreise" name="group_checkin" context="{'group_by':'check_in'}"/>
            </search>
        </field>
    </record>

    <record id="view_kjr_booking_list" model="ir.ui.view">
        <field name="name">kjr.facility.booking.list</field>
        <field name="model">kjr.facility.booking</field>
        <field name="arch" type="xml">
            <list string="Buchungen"
                  decoration-muted="state == 'cancelled'"
                  decoration-success="state in ('invoiced','done')"
                  decoration-warning="state == 'reserved'"
                  decoration-info="state == 'draft'">
                <field name="name"/>
                <field name="facility_id"/>
                <field name="partner_id"/>
                <field name="group_name" optional="show"/>
                <field name="contact_person" optional="hide"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <field name="nights" optional="hide"/>
                <field name="participant_count" string="TN"/>
                <field name="amount_total" widget="monetary"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="handover_out_date" string="Rücknahme" optional="hide"/>
                <field name="handover_out_damage" optional="hide"/>
                <field name="payment_status" widget="badge" optional="show"
                       decoration-warning="payment_status in ('not_paid','partial')"
                       decoration-success="payment_status == 'paid'"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'reserved'"
                       decoration-success="state in ('invoiced','done')"
                       decoration-danger="state == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_kjr_booking_calendar" model="ir.ui.view">
        <field name="name">kjr.facility.booking.calendar</field>
        <field name="model">kjr.facility.booking</field>
        <field name="arch" type="xml">
            <calendar string="Belegung" date_start="check_in" date_stop="check_out"
                      color="calendar_color" mode="month">
                <field name="calendar_color"/>
                <field name="facility_id" filters="1"/>
                <field name="partner_id"/>
                <field name="participant_count"/>
                <field name="state"/>
            </calendar>
        </field>
    </record>

    <record id="view_kjr_booking_form" model="ir.ui.view">
        <field name="name">kjr.facility.booking.form</field>
        <field name="model">kjr.facility.booking</field>
        <field name="arch" type="xml">
            <form string="Einrichtungsbuchung">
                <header>
                    <button name="action_reserve" string="Reservieren (vormerken)" type="object"
                            invisible="state != 'draft'"/>
                    <button name="action_confirm" string="Verbindlich buchen" type="object"
                            class="btn-primary" invisible="state not in ('draft','reserved')"/>
                    <button name="action_request_deposit" string="Anzahlung anfordern" type="object"
                            invisible="state != 'confirmed'"/>
                    <button name="action_check_in" string="Anreise" type="object"
                            invisible="state not in ('confirmed','deposit')"/>
                    <button name="action_create_invoice" string="Rechnung erstellen" type="object"
                            class="btn-primary" invisible="state not in ('checked_in',) or invoice_id"/>
                    <button name="action_done" string="Abschließen" type="object"
                            invisible="state not in ('checked_in','invoiced')"/>
                    <button name="action_handover_arrival" string="Übergabe Anreise erfassen"
                            type="object"
                            invisible="state not in ('confirmed','deposit','checked_in','invoiced')"/>
                    <button name="action_handover_departure" string="Rücknahme Abreise erfassen"
                            type="object" invisible="state not in ('checked_in','invoiced')"/>
                    <button name="action_print_contract" string="Vertrag drucken" type="object" icon="fa-print"/>
                    <button name="action_print_handover" string="Übergabeprotokoll drucken"
                            type="object" icon="fa-print" invisible="not is_booked"/>
                    <button name="action_cancel" string="Stornieren" type="object"
                            invisible="state in ('done','cancelled')"
                            confirm="Diese Buchung wirklich stornieren?"/>
                    <button name="action_reset_draft" string="Auf Anfrage zurück" type="object"
                            groups="kjr_facility.group_kjr_facility_manager"
                            invisible="state in ('draft','invoiced','done','cancelled')"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,reserved,confirmed,deposit,checked_in,invoiced,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button type="object" name="action_view_invoice" class="oe_stat_button"
                                icon="fa-pencil-square-o" invisible="not invoice_id">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Rechnung</span>
                            </div>
                        </button>
                    </div>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <!-- F2: Weicher Hinweis auf verletzte Belegungsregeln (kein Constraint) -->
                    <div class="alert alert-warning" role="alert"
                         invisible="not occupancy_warning">
                        <i class="fa fa-exclamation-triangle me-1" title="Warnung"/>
                        <field name="occupancy_warning" readonly="1" nolabel="1" class="d-inline"/>
                    </div>
                    <group>
                        <group string="Gruppe">
                            <field name="partner_id" readonly="state not in ('draft','reserved','confirmed')"/>
                            <field name="group_name"/>
                            <field name="contact_person"/>
                            <field name="contact_email"/>
                            <field name="contact_phone"/>
                        </group>
                        <group string="Einrichtung &amp; Zeitraum">
                            <field name="facility_id" readonly="state not in ('draft','reserved','confirmed')"/>
                            <field name="check_in" readonly="state in ('invoiced','done','cancelled')"/>
                            <field name="arrival_time" widget="float_time"/>
                            <field name="check_out" readonly="state in ('invoiced','done','cancelled')"/>
                            <field name="departure_time" widget="float_time"/>
                            <field name="nights"/>
                            <field name="is_booked"/>
                            <!-- Nur fuer die Sichtbarkeitssteuerung der
                                 Verpflegungsangaben (related auf die Einrichtung). -->
                            <field name="facility_offers_catering" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Reservierung" invisible="state == 'draft'">
                            <field name="reservation_date" readonly="1"/>
                            <field name="reservation_expiry"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Belegung &amp; Leistungen" name="main">
                            <group>
                                <group string="Belegung">
                                    <field name="participant_count"/>
                                    <field name="leader_count"/>
                                    <field name="supervision_ok"/>
                                    <field name="is_organized_group"/>
                                    <field name="room_ids" widget="many2many_tags"
                                           domain="[('facility_id','=',facility_id)]"/>
                                    <field name="bed_count"/>
                                </group>
                                <group string="Leistungen">
                                    <field name="tariff_id"/>
                                    <!-- Verpflegung ausblenden, wenn die Einrichtung
                                         keine anbietet (Selbstversorgerhaus). Altvorgaenge
                                         mit bereits erfasster Verpflegung bleiben sichtbar,
                                         damit keine berechnete Position aus der Ansicht
                                         verschwindet. Das Feld ist required mit Default
                                         'none'; ein ausgeblendetes Feld wird in Odoo 19
                                         nicht gesendet und nicht als Pflichtfeld geprueft,
                                         das Speichern bleibt also moeglich. -->
                                    <field name="meal_option"
                                           invisible="not facility_offers_catering and not amount_meals and meal_option == 'none'"/>
                                    <field name="equipment_ids" widget="many2many_tags"
                                           domain="[('facility_id','=',facility_id)]"/>
                                    <field name="is_grant_funded"/>
                                    <field name="grant_reference" invisible="not is_grant_funded"/>
                                </group>
                            </group>
                            <field name="equipment_notes" placeholder="Anmerkungen zur Ausstattung..."/>
                        </page>
                        <page string="Beträge" name="amounts">
                            <group>
                                <group>
                                    <field name="amount_accommodation"/>
                                    <field name="amount_meals"
                                           invisible="not facility_offers_catering and not amount_meals and meal_option == 'none'"/>
                                    <field name="amount_equipment"/>
                                    <field name="amount_cleaning"/>
                                    <field name="visitor_tax_exempt_count"/>
                                    <field name="amount_visitor_tax"/>
                                </group>
                                <group>
                                    <field name="amount_untaxed"/>
                                    <field name="amount_tax"/>
                                    <field name="amount_total"/>
                                    <field name="deposit_pct"/>
                                    <field name="deposit_amount"/>
                                    <field name="deposit_due_date"/>
                                    <field name="deposit_paid"/>
                                </group>
                            </group>
                            <group>
                                <group string="Zahlung &amp; Vertrag">
                                    <field name="payment_status"/>
                                    <field name="contract_sent_date" readonly="1"/>
                                    <field name="contract_signed"/>
                                </group>
                            </group>
                            <field name="currency_id" invisible="1"/>
                            <!-- Technische Hilfsfelder: invoice_id steuert die Schaltflaechen
                                 "Rechnung erstellen" (Kopfzeile) und "Rechnung" (Statistik-
                                 Schaltflaeche). Ein invisible-Ausdruck kann in Odoo 19 nur
                                 Felder auswerten, die im Arch stehen — ohne diese Zeile
                                 blieben beide Bedingungen wirkungslos. -->
                            <field name="invoice_id" invisible="1"/>
                        </page>
                        <!-- Übergabeprotokoll: erst ab der verbindlichen Buchung sichtbar
                             (is_booked = gebucht/Anzahlung/angereist/berechnet/abgeschlossen). -->
                        <page string="Übergabe" name="handover" invisible="not is_booked">
                            <div class="alert alert-info" role="alert">
                                <i class="fa fa-info-circle me-1" title="Hinweis"/>
                                Das Übergabeprotokoll dokumentiert den ZUSTAND von Haus bzw. Zeltplatz.
                                Es ist keine Freigabebedingung: Ein festgestellter Mangel verhindert den
                                Abschluss der Buchung nicht, er verlangt nur einen Vermerk. Bitte die
                                Häkchen niemals wahrheitswidrig setzen — sobald „Schaden festgestellt"
                                angekreuzt ist, wird beim Erfassen eine Schadensbeschreibung verlangt.
                            </div>
                            <group>
                                <group string="Anreise — Übergabe an die Gruppe">
                                    <field name="handover_in_date"/>
                                    <field name="handover_in_user_id"/>
                                    <field name="handover_in_received_by"/>
                                    <field name="handover_in_condition"/>
                                    <field name="handover_in_keys"/>
                                    <field name="handover_in_damage"/>
                                    <field name="handover_in_damage_note"
                                           invisible="not handover_in_damage"
                                           placeholder="Pflicht, sobald ein Schaden festgestellt wurde: was, wo, seit wann, wer hat es festgestellt..."/>
                                </group>
                                <group string="Zählerstände Anreise">
                                    <field name="handover_in_meter_electricity"/>
                                    <field name="handover_in_meter_water"/>
                                    <field name="handover_in_meter_gas"/>
                                </group>
                            </group>
                            <field name="handover_in_note"
                                   placeholder="Vermerk zur Übergabe: Einweisung, Absprachen, Besonderheiten..."/>
                            <!-- Abreiseteil erst nach der Anreise, vorher gibt es nichts zurückzunehmen. -->
                            <group invisible="state not in ('checked_in','invoiced','done')">
                                <group string="Abreise — Rücknahme von der Gruppe">
                                    <field name="handover_out_date"/>
                                    <field name="handover_out_user_id"/>
                                    <field name="handover_out_handed_by"/>
                                    <field name="handover_out_condition"/>
                                    <field name="handover_out_keys"/>
                                    <field name="handover_out_cleaning_ok"/>
                                    <field name="handover_out_damage"/>
                                    <field name="handover_out_damage_note"
                                           invisible="not handover_out_damage"
                                           placeholder="Pflicht, sobald ein Schaden festgestellt wurde: was fehlt, was ist beschädigt, was wurde vereinbart..."/>
                                </group>
                                <group string="Zählerstände Abreise">
                                    <field name="handover_out_meter_electricity"/>
                                    <field name="handover_out_meter_water"/>
                                    <field name="handover_out_meter_gas"/>
                                </group>
                            </group>
                            <field name="handover_out_note"
                                   invisible="state not in ('checked_in','invoiced','done')"
                                   placeholder="Vermerk zur Rücknahme: Reinigungszustand, offene Punkte, abweichende Schlüsselzahl..."/>
                        </page>
                        <page string="Notizen" name="notes">
                            <field name="note" placeholder="Anmerkungen (für Gruppe sichtbar im Portal)..."/>
                            <separator string="Intern"/>
                            <field name="internal_note" placeholder="Interne Notiz..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_kjr_booking" model="ir.actions.act_window">
        <field name="name">Buchungen</field>
        <field name="res_model">kjr.facility.booking</field>
        <field name="view_mode">list,calendar,form</field>
        <field name="search_view_id" ref="view_kjr_booking_search"/>
        <field name="context">{'search_default_upcoming': 1}</field>
    </record>

</odoo>
