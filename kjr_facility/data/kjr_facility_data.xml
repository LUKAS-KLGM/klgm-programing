<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Stammdaten sind im Backend pflegbar; noupdate=1 erhält Anpassungen bei Updates. -->
    <data noupdate="1">

        <!-- ── Jugendtagungshaus Diepolz ──────────────────────────────────
             Stammdaten am 17.08.2026 von Marvin Gutknecht anhand der Live-Seite
             und der beiden dort hängenden Zimmerpläne korrigiert (Quelle:
             „KJR Website - Ist-Zustand 2026-08-17", Abschnitt 10). Er hat die
             Instanz bereits gepflegt — hier ziehen wir den Seed nach, damit eine
             Neuinstallation nicht wieder die Platzhalter anlegt.
             Vorher: „Jugendhaus Diepolz", ohne Adresse, drei Platzhalterzimmer
             mit zusammen 24 Betten gegen einen Beschreibungstext, der 42 nennt. -->
        <record id="facility_diepolz" model="kjr.facility">
            <field name="name">Jugendtagungshaus Diepolz</field>
            <field name="code">DIE</field>
            <field name="sequence">10</field>
            <field name="facility_type">house</field>
            <field name="color">4</field>
            <field name="capacity">42</field>
            <field name="supervision_ratio">6</field>
            <field name="street">Diepolz 2 1/2</field>
            <field name="zip">87509</field>
            <field name="city">Immenstadt</field>
            <field name="description_short">Selbstversorgerhaus für Gruppen, 42 Betten in 12 Zimmern.</field>
        </record>
        <!-- 12 Schlafräume, zusammen 42 Betten: 1. OG 24 (Zimmer 11-14 je 4, 15 und 16
             je 3, 17 mit 2), DG 18 (Zimmer 21 und 22 je 4, 23 und 24 je 3, 25 mit 4).
             TODO(KJR): Zimmer 25 hat laut Zimmerplan 3, laut Fließtext 4 Betten. Wir
             folgen dem Fließtext, damit die Summe die überall genannten 42 ergibt —
             von der Geschäftsstelle bestätigen lassen. -->
        <record id="room_diepolz_11" model="kjr.facility.room">
            <field name="facility_id" ref="facility_diepolz"/>
            <field name="sequence">10</field>
            <field name="name">Zimmer 11 (1. OG)</field><field name="capacity">4</field>
        </record>
        <record id="room_diepolz_12" model="kjr.facility.room">
            <field name="facility_id" ref="facility_diepolz"/>
            <field name="sequence">20</field>
            <field name="name">Zimmer 12 (1. OG)</field><field name="capacity">4</field>
        </record>
        <record id="room_diepolz_13" model="kjr.facility.room">
            <field name="facility_id" ref="facility_diepolz"/>
            <field name="sequence">30</field>
