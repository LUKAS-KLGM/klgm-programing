<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Stammdaten sind im Backend pflegbar; noupdate=1 erhält Anpassungen bei Updates. -->
    <data noupdate="1">

        <!-- ── Jugendtagungshaus Diepolz ──────────────────────────────────
             Stammdaten am 17.08.2026 durch die Projektleitung anhand der
             Live-Seite und der beiden dort hängenden Zimmerpläne korrigiert
             (Quelle: Projektunterlagen, Stand 17.08.2026). Die Instanz war
             bereits gepflegt — hier ziehen wir den Seed nach, damit eine
             Neuinstallation nicht wieder die Platzhalter anlegt.
             Vorher: „Jugendhaus Diepolz", ohne Adresse, drei Platzhalterzimmer
             mit zusammen 24 Betten gegen einen Beschreibungstext, der 42 nennt. -->
        <record id="facility_diepolz" model="kjr.facility">
            <field name="name">Jugendtagungshaus Diepolz</field>
            <field name="code">DIE</field>
            <field name="sequence">10</field>
            <field name="facility_type">house</field>
            <field name="color">4</field>
            <field name="capacity">42</field>
            <field name="supervision_ratio">6</field>
            <field name="street">Diepolz 2 1/2</field>
            <field name="zip">87509</field>
            <field name="city">Immenstadt</field>
            <field name="description_short">Selbstversorgerhaus für Gruppen, 42 Betten in 12 Zimmern.</field>
            <!-- Keine Verpflegung: Diepolz ist ein reines Selbstversorgerhaus, die
                 Gruppe kocht selbst in der Großküche (Quelle: Kundenaussage KJR vom
                 21.08.2026; deckt sich mit der Kurzbeschreibung und dem
                 Ausstattungseintrag "Großküche"). Das Buchungsformular bot bis dahin
                 Frühstück/Halb-/Vollpension an — Leistungen, die der KJR nicht
                 erbringt. -->
            <field name="offers_catering" eval="False"/>
        </record>
        <!-- 12 Schlafräume, zusammen 42 Betten: 1. OG 24 (Zimmer 11-14 je 4, 15 und 16
             je 3, 17 mit 2), DG 18 (Zimmer 21 und 22 je 4, 23 und 24 je 3, 25 mit 4).
             TODO(Kunde): Zimmer 25 hat laut Zimmerplan 3, laut Fließtext 4 Betten. Wir
             folgen dem Fließtext, damit die Summe die überall genannten 42 ergibt —
             von der Geschäftsstelle bestätigen lassen.

             NOUPDATE UND DOPPELTE RÄUME (Befund 01.09.2026, geprüft am 11.10.2026):
             Diese Datei liegt vollständig unter noupdate="1" (siehe oben), und die
             Räume tragen stabile XML-IDs (room_diepolz_11 bis room_diepolz_25).
             Gepflegte Kapazitäten werden von einem Modul-Update deshalb NICHT
             zurückgeschrieben.
             Was noupdate NICHT leistet: Räume, deren XML-ID die Instanz noch nicht
             kennt, werden beim Update trotzdem angelegt (odoo/tools/convert.py, Zweig
             "elif not nodeattr2bool(rec, 'forcecreate', True)" — forcecreate ist
             standardmäßig True). Genau so entstanden am 01.09.2026 die doppelten
             Schlafräume neben den von Hand gepflegten, und bed_total zeigte 84 statt 42.
             forcecreate="0" wäre die einzige echte Sperre, würde aber jede
             Neuinstallation ohne Zimmer zurücklassen und ist deshalb bewusst NICHT
             gesetzt. Erkannt wird der Fall stattdessen von
             migrations/19.0.7.3.0/post-raum-duplikate.py, das nur warnt und keine
             Daten ändert.
             FOLGE FÜR KÜNFTIGE ÄNDERUNGEN: Wer hier Namen oder Kapazitäten ändert,
             erreicht damit nur Neuinstallationen. Bestandsinstanzen brauchen dafür
             ein Migrationsskript. -->
        <record id="room_diepolz_11" model="kjr.facility.room">
            <field name="facility_id" ref="facility_diepolz"/>
            <field name="sequence">10</field>
            <field name="name">Zimmer 11 (1. OG)</field><field name="capacity">4</field>
        </record>
        <record id="room_diepolz_12" model="kjr.facility.room">
            <field name="facility_id" ref="facility_diepolz"/>
            <field name="sequence">20</field>
            <field name="name">Zimmer 12 (1. OG)</field><field name="capacity">4</field>
        </record>
        <record id="room_diepolz_13" model="kjr.facility.room">
            <field name="facility_id" ref="facility_diepolz"/>
            <field name="sequence">30</field>
            <field name="name">Zimmer 13 (1. OG)</field><field name="capacity">4</field>
        </record>
        <record id="room_diepolz_14" model="kjr.facility.room">
            <field name="facility_id" ref="facility_diepolz"/>
            <field name="sequence">40</field>
            <field name="name">Zimmer 14 (1. OG)</field><field name="capacity">4</field>
        </record>
        <record id="room_diepolz_15" model="kjr.facility.room">
            <field name="facility_id" ref="facility_diepolz"/>
            <field name="sequence">50</field>
            <field name="name">Zimmer 15 (1. OG)</field><field name="capacity">3</field>
        </record>
        <record id="room_diepolz_16" model="kjr.facility.room">
            <field name="facility_id" ref="facility_diepolz"/>
            <field name="sequence">60</field>
            <field name="name">Zimmer 16 (1. OG)</field><field name="capacity">3</field>
        </record>
        <record id="room_diepolz_17" model="kjr.facility.room">
            <field name="facility_id" ref="facility_diepolz"/>
            <field name="sequence">70</field>
            <field name="name">Zimmer 17 (1. OG)</field><field name="capacity">2</field>
        </record>
        <record id="room_diepolz_21" model="kjr.facility.room">
            <field name="facility_id" ref="facility_diepolz"/>
            <field name="sequence">80</field>
            <field name="name">Zimmer 21 (DG)</field><field name="capacity">4</field>
        </record>
        <record id="room_diepolz_22" model="kjr.facility.room">
            <field name="facility_id" ref="facility_diepolz"/>
            <field name="sequence">90</field>
            <field name="name">Zimmer 22 (DG)</field><field name="capacity">4</field>
        </record>
        <record id="room_diepolz_23" model="kjr.facility.room">
            <field name="facility_id" ref="facility_diepolz"/>
            <field name="sequence">100</field>
            <field name="name">Zimmer 23 (DG)</field><field name="capacity">3</field>
        </record>
        <record id="room_diepolz_24" model="kjr.facility.room">
            <field name="facility_id" ref="facility_diepolz"/>
            <field name="sequence">110</field>
            <field name="name">Zimmer 24 (DG)</field><field name="capacity">3</field>
        </record>
        <record id="room_diepolz_25" model="kjr.facility.room">
            <field name="facility_id" ref="facility_diepolz"/>
            <field name="sequence">120</field>
            <field name="name">Zimmer 25 (DG)</field><field name="capacity">4</field>
        </record>
        <record id="equip_diepolz_kitchen" model="kjr.facility.equipment">
            <field name="facility_id" ref="facility_diepolz"/>
            <field name="name">Großküche</field><field name="category">Küche</field>
            <field name="icon">fa-cutlery</field>
        </record>
        <record id="equip_diepolz_beamer" model="kjr.facility.equipment">
            <field name="facility_id" ref="facility_diepolz"/>
            <field name="name">Beamer + Leinwand</field><field name="category">Technik</field>
            <!-- TODO(Kunde): Preis nicht belegt — 0,00 € als Platzhalter. Die hier zuvor
                 hinterlegten 15,00 €/Tag standen in keiner Quelle; die einzige
                 vorliegende Preisliste (Quelle: Projektunterlagen, Stand 18.08.2026,
                 Abschnitt Technik des Materialverleihs) führt einen Beamer mit
                 5,00 €/Tag, aber ohne Leinwand und für den Materialverleih, nicht für
                 die Ausstattung des Hauses. Ausstattungspreise gehen über
                 amount_equipment in Angebotsvorschau, Vertrag und Rechnung ein —
                 deshalb 0,00 € statt einer geschätzten Zahl. -->
            <field name="price_per_day">0.0</field><field name="quantity">1</field>
            <field name="icon">fa-video-camera</field>
        </record>

        <!-- ── Jugendzeltplatz NiSo (Niedersonthofener See, Waltenhofen) ───
             Der Datensatz wies den Platz fälschlich in einem anderen Ort aus.
             NiSo steht für den Niedersonthofener See, der in Waltenhofen liegt —
             korrigiert am 17.08.2026 durch die Projektleitung, bestätigt über die
             Buchungsportal-URL des Betreibers (Quelle: Projektunterlagen,
             Stand 17.08.2026). -->
        <record id="facility_niso" model="kjr.facility">
            <field name="name">Jugendzeltplatz NiSo</field>
            <field name="code">NISO</field>
            <field name="sequence">20</field>
            <field name="facility_type">campsite</field>
            <field name="color">10</field>
            <field name="capacity">40</field>
            <field name="supervision_ratio">6</field>
            <field name="street">Am Niedersonthofener See</field>
            <field name="zip">87448</field>
            <field name="city">Waltenhofen</field>
            <field name="description_short">Naturnaher Zeltplatz (Naturschutzgebiet) für max. 40 Personen.</field>
            <!-- Keine Verpflegung: auch der Zeltplatz ist reine Selbstversorgung
                 (Quelle: Kundenaussage KJR vom 21.08.2026). -->
            <field name="offers_catering" eval="False"/>
        </record>
        <record id="room_niso_area" model="kjr.facility.room">
            <field name="facility_id" ref="facility_niso"/>
            <field name="name">Zeltwiese</field><field name="capacity">40</field>
        </record>
        <record id="equip_niso_fire" model="kjr.facility.equipment">
            <field name="facility_id" ref="facility_niso"/>
            <field name="name">Lagerfeuerstelle</field><field name="category">Außen</field>
            <field name="icon">fa-fire</field>
        </record>

        <!-- ── Tarife (Preise/Steuer im Backend zu pflegen) ─────────────────
             ACHTUNG PREISE: Die vier Tarifgruppen starten bewusst mit 0,00 € pro
             Person und Nacht. Belegt ist in den Projektunterlagen (geprüft am
             18.08.2026) einzig der Abschnitt "Einrichtungen" der Bestandsaufnahme
             vom 17.08.2026: Belegungspreise des
             JUGENDZELTPLATZES von 4,00 € bzw. 5,50 € pro Person und Nacht. Aus der
             Quelle geht NICHT hervor, welcher der beiden Sätze zu welcher Tarifgruppe
             gehört; für das Jugendtagungshaus Diepolz nennt der Vault gar keinen
             Betrag (der Preisblock steht nur auf der Live-Seite). Die zuvor hier
             hinterlegten 6,00 / 8,00 / 11,00 / 18,00 € waren nirgends belegt und
             widersprachen dieser Quelle sogar — deshalb 0,00 €: ein Nullpreis fällt
             in der Pflege auf, eine erfundene Zahl nicht.
             TODO(Kunde): Preisblock der Live-Seite je Einrichtung und Tarifgruppe
             bestätigen lassen und eintragen. Unterscheiden sich die Preise je
             Einrichtung, kann je Einrichtung ein eigener Tarif mit gesetztem
             facility_id angelegt werden (leeres Feld = gilt für alle Einrichtungen).
             Zur Verpflegung: Beide Einrichtungen sind Selbstversorger
             (offers_catering = False), die Verpflegungssätze der Tarife bleiben
             deshalb ungenutzt auf 0,00 € und werden in der Tarifmaske gar nicht
             erst angezeigt. Für einen Jugendring MIT Verpflegung wird der Schalter
             an der Einrichtung aktiviert; erst dann sind die Sätze zu pflegen.
             Offen bleiben ebenso Verpflegungssätze, Endreinigung und der
             Kurbeitrag — auch dazu widerspricht sich die Live-Seite (siehe
             Abschnitt 10 derselben Bestandsaufnahme). Die kundensichtbare
             Bezeichnung ist seit 11.10.2026 einheitlich "Kurbeitrag"; der
             technische Feldname bleibt visitor_tax_* (Begruendung am Feld
             kjr.facility.tariff.visitor_tax_per_person_night). -->
        <record id="tariff_kjr_member" model="kjr.facility.tariff">
            <field name="name">KJR-Mitgliedsverband</field>
            <field name="tariff_type">kjr_member</field>
            <field name="sequence">10</field>
            <!-- TODO(Kunde): Preis nicht belegt — 0,00 € als Platzhalter. -->
            <field name="price_per_person_night">0.0</field>
        </record>
        <record id="tariff_partner" model="kjr.facility.tariff">
            <field name="name">Partnerorganisation</field>
            <field name="tariff_type">partner</field>
            <field name="sequence">20</field>
            <!-- TODO(Kunde): Preis nicht belegt — 0,00 € als Platzhalter. -->
            <field name="price_per_person_night">0.0</field>
        </record>
        <record id="tariff_standard" model="kjr.facility.tariff">
            <field name="name">Standard (gemeinnützig)</field>
            <field name="tariff_type">standard</field>
            <field name="sequence">30</field>
            <!-- TODO(Kunde): Preis nicht belegt — 0,00 € als Platzhalter. -->
            <field name="price_per_person_night">0.0</field>
        </record>
        <record id="tariff_commercial" model="kjr.facility.tariff">
            <field name="name">Kommerziell</field>
            <field name="tariff_type">commercial</field>
            <field name="sequence">40</field>
            <!-- TODO(Kunde): Preis nicht belegt — 0,00 € als Platzhalter. -->
            <field name="price_per_person_night">0.0</field>
        </record>

    </data>
</odoo>
