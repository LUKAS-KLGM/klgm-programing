        </record>
        <record id="equip_diepolz_beamer" model="kjr.facility.equipment">
            <field name="facility_id" ref="facility_diepolz"/>
            <field name="name">Beamer + Leinwand</field><field name="category">Technik</field>
            <!-- TODO(KJR): Preis nicht belegt — 0,00 € als Platzhalter. Die hier zuvor
                 hinterlegten 15,00 €/Tag standen in keiner Quelle; die einzige Preisliste
                 im Vault ("08 Kundenprojekte/01 KJR Oberallgäu/KJR-Website-Inhalte/
                 04d_Verleih/INHALT.md", Abschnitt Technik) führt einen Beamer mit
                 5,00 €/Tag, aber ohne Leinwand und für den Materialverleih, nicht für
                 die Ausstattung des Hauses. Ausstattungspreise gehen über
                 amount_equipment in Angebotsvorschau, Vertrag und Rechnung ein —
                 deshalb 0,00 € statt einer geschätzten Zahl. -->
            <field name="price_per_day">0.0</field><field name="quantity">1</field>
            <field name="icon">fa-video-camera</field>
        </record>

        <!-- ── Jugendzeltplatz NiSo (Niedersonthofener See, Waltenhofen) ───
             Der Datensatz wies den Platz fälschlich in Oberstdorf aus. NiSo steht
             für den Niedersonthofener See, der in Waltenhofen liegt — korrigiert
             von Marvin Gutknecht am 17.08.2026, bestätigt über die Buchungsportal-
             URL des KJR. -->
        <record id="facility_niso" model="kjr.facility">
            <field name="name">Jugendzeltplatz NiSo</field>
            <field name="code">NISO</field>
            <field name="sequence">20</field>
            <field name="facility_type">campsite</field>
            <field name="color">10</field>
            <field name="capacity">40</field>
            <field name="supervision_ratio">6</field>
            <field name="street">Am Niedersonthofener See</field>
            <field name="zip">87448</field>
            <field name="city">Waltenhofen</field>
            <field name="description_short">Naturnaher Zeltplatz (Naturschutzgebiet) für max. 40 Personen.</field>
        </record>
        <record id="room_niso_area" model="kjr.facility.room">
            <field name="facility_id" ref="facility_niso"/>
            <field name="name">Zeltwiese</field><field name="capacity">40</field>
        </record>
        <record id="equip_niso_fire" model="kjr.facility.equipment">
            <field name="facility_id" ref="facility_niso"/>
            <field name="name">Lagerfeuerstelle</field><field name="category">Außen</field>
            <field name="icon">fa-fire</field>
        </record>

        <!-- ── Tarife (Preise/Steuer im Backend zu pflegen) ─────────────────
             ACHTUNG PREISE: Die vier Tarifgruppen starten bewusst mit 0,00 € pro
             Person und Nacht. Belegt ist im Vault (geprüft am 18.08.2026) einzig
             "08 Kundenprojekte/01 KJR Oberallgäu/KJR Website - Ist-Zustand
             2026-08-17.md", Abschnitt 5 ("Einrichtungen"): Belegungspreise des
             JUGENDZELTPLATZES von 4,00 € bzw. 5,50 € pro Person und Nacht. Aus der
             Quelle geht NICHT hervor, welcher der beiden Sätze zu welcher Tarifgruppe
             gehört; für das Jugendtagungshaus Diepolz nennt der Vault gar keinen
             Betrag (der Preisblock steht nur auf der Live-Seite). Die zuvor hier
             hinterlegten 6,00 / 8,00 / 11,00 / 18,00 € waren nirgends belegt und
             widersprachen dieser Quelle sogar — deshalb 0,00 €: ein Nullpreis fällt
             in der Pflege auf, eine erfundene Zahl nicht.
             TODO(KJR): Preisblock der Live-Seite je Einrichtung und Tarifgruppe
             bestätigen lassen und eintragen. Unterscheiden sich die Preise je
             Einrichtung, kann je Einrichtung ein eigener Tarif mit gesetztem
             facility_id angelegt werden (leeres Feld = gilt für alle Einrichtungen).
             Offen bleiben ebenso Verpflegungssätze, Endreinigung und der
             Fremdenverkehrs-/Kurbeitrag — auch dazu widerspricht sich die
             Live-Seite (siehe Abschnitt 10 derselben Notiz). -->
        <record id="tariff_kjr_member" model="kjr.facility.tariff">
            <field name="name">KJR-Mitgliedsverband</field>
            <field name="tariff_type">kjr_member</field>
            <field name="sequence">10</field>
            <!-- TODO(KJR): Preis nicht belegt — 0,00 € als Platzhalter. -->
            <field name="price_per_person_night">0.0</field>
        </record>
        <record id="tariff_partner" model="kjr.facility.tariff">
            <field name="name">Partnerorganisation</field>
            <field name="tariff_type">partner</field>
            <field name="sequence">20</field>
            <!-- TODO(KJR): Preis nicht belegt — 0,00 € als Platzhalter. -->
            <field name="price_per_person_night">0.0</field>
        </record>
        <record id="tariff_standard" model="kjr.facility.tariff">
            <field name="name">Standard (gemeinnützig)</field>
            <field name="tariff_type">standard</field>
            <field name="sequence">30</field>
            <!-- TODO(KJR): Preis nicht belegt — 0,00 € als Platzhalter. -->
            <field name="price_per_person_night">0.0</field>
        </record>
        <record id="tariff_commercial" model="kjr.facility.tariff">
