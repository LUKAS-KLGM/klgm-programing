<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Anmeldung, Formular: Schaltflächen und Stand der digitalen Einwilligung.
         Anker laut Schnittstelle zu kjr_event: <header> und das Feld
         parental_consent (aus kjr_event.view_event_registration_form_kjr). -->
    <record id="view_event_registration_form_kjr_sign" model="ir.ui.view">
        <field name="name">event.registration.form.kjr.sign</field>
        <field name="model">event.registration</field>
        <field name="inherit_id" ref="event.view_event_registration_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_kjr_sign_request_send" type="object"
                        string="Unterschrift anfordern" class="btn-secondary"
                        groups="event.group_event_user"
                        invisible="state == 'cancel' or not kjr_sign_enabled or not consent_missing or kjr_sign_state in ('sent', 'signed')"/>
                <button name="action_kjr_sign_request_resend" type="object"
                        string="Erneut senden" class="btn-secondary"
                        groups="event.group_event_user"
                        confirm="Die offene Unterschriftsanfrage wird storniert und eine neue verschickt. Fortfahren?"
                        invisible="state == 'cancel' or not kjr_sign_enabled or not consent_missing or kjr_sign_state != 'sent'"/>
                <button name="action_kjr_sign_request_cancel" type="object"
                        string="Anfrage stornieren" class="btn-secondary"
                        groups="event.group_event_user"
                        confirm="Die offene Unterschriftsanfrage wird storniert. Die Anmeldung bleibt gesperrt, bis die Einwilligung vorliegt. Fortfahren?"
                        invisible="kjr_sign_state != 'sent'"/>
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_kjr_open_sign_request" type="object"
                        class="oe_stat_button" icon="fa-pencil-square-o"
                        groups="sign.group_sign_user"
                        invisible="kjr_sign_state == 'none'">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Unterschrift</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@name='parental_consent']" position="after">
                <field name="kjr_sign_enabled" invisible="1"/>
                <field name="kjr_sign_state" widget="badge"
                       decoration-warning="kjr_sign_state == 'sent'"
                       decoration-success="kjr_sign_state == 'signed'"
                       decoration-danger="kjr_sign_state in ('refused', 'expired')"
                       invisible="kjr_sign_state == 'none' and not kjr_sign_enabled"/>
                <field name="kjr_sign_request_id" groups="sign.group_sign_user"
                       readonly="1" invisible="kjr_sign_state == 'none'"/>
                <field name="kjr_sign_error" readonly="1" invisible="not kjr_sign_error"/>
            </xpath>
        </field>
    </record>

    <!-- Anmeldung, Standardliste von Odoo -->
    <record id="view_event_registration_tree_kjr_sign" model="ir.ui.view">
        <field name="name">event.registration.list.kjr.sign</field>
        <field name="model">event.registration</field>
        <field name="inherit_id" ref="event.view_event_registration_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="after">
                <field name="kjr_sign_state" optional="hide" widget="badge"
                       decoration-warning="kjr_sign_state == 'sent'"
                       decoration-success="kjr_sign_state == 'signed'"
                       decoration-danger="kjr_sign_state in ('refused', 'expired')"/>
            </xpath>
        </field>
    </record>

    <!-- Anmeldung, Standardsuche von Odoo -->
    <record id="view_registration_search_kjr_sign" model="ir.ui.view">
        <field name="name">event.registration.search.kjr.sign</field>
        <field name="model">event.registration</field>
        <field name="inherit_id" ref="event.view_registration_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='attended']" position="after">
                <separator/>
                <filter string="Unterschrift offen" name="kjr_sign_open"
                        domain="[('kjr_sign_state', '=', 'sent')]"/>
                <filter string="Unterschrift abgelehnt/abgelaufen" name="kjr_sign_problem"
                        domain="[('kjr_sign_state', 'in', ('refused', 'expired'))]"/>
            </xpath>
            <xpath expr="//group" position="inside">
                <filter string="Stand Unterschrift" name="group_kjr_sign_state"
                        context="{'group_by': 'kjr_sign_state'}"/>
            </xpath>
        </field>
    </record>

    <!-- KJR-Teilnehmerliste (Menü "KJR-Teilnehmer/innen" aus kjr_event).
         Anker ist bewusst nur das Wurzelelement, damit Änderungen an den
         Spalten in kjr_event diese Erweiterung nicht brechen. -->
    <record id="view_kjr_registration_list_kjr_sign" model="ir.ui.view">
        <field name="name">event.registration.list.kjr.sign.kjr</field>
        <field name="model">event.registration</field>
        <field name="inherit_id" ref="kjr_event.view_kjr_registration_list"/>
        <field name="arch" type="xml">
            <xpath expr="//list" position="inside">
                <field name="kjr_sign_state" optional="show" widget="badge"
                       decoration-warning="kjr_sign_state == 'sent'"
                       decoration-success="kjr_sign_state == 'signed'"
                       decoration-danger="kjr_sign_state in ('refused', 'expired')"/>
            </xpath>
        </field>
    </record>

    <record id="view_kjr_registration_search_kjr_sign" model="ir.ui.view">
        <field name="name">event.registration.search.kjr.sign.kjr</field>
        <field name="model">event.registration</field>
        <field name="inherit_id" ref="kjr_event.view_kjr_registration_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter string="Unterschrift offen" name="kjr_sign_open"
                        domain="[('kjr_sign_state', '=', 'sent')]"/>
                <filter string="Unterschrift abgelehnt/abgelaufen" name="kjr_sign_problem"
                        domain="[('kjr_sign_state', 'in', ('refused', 'expired'))]"/>
                <filter string="Stand Unterschrift" name="group_kjr_sign_state"
                        context="{'group_by': 'kjr_sign_state'}"/>
            </xpath>
        </field>
    </record>

</odoo>
