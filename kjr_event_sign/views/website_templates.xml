<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Datenschutzblock im Anmeldedialog: Hinweis auf die digitale
         Unterschrift. Anker <t name="kjr_consent_privacy_extra"/> liefert
         kjr_event (Schnittstelle).
         Pflichtinformation (Art. 13 DSGVO): Der Speicherort muss dem
         tatsächlichen Verhalten entsprechen. Der _sign-Hook entfernt die Kopie
         an der Anmeldung; der Nachweis liegt nur an der Unterschriftsanfrage
         (bleibt bei der Anonymisierung archiviert erhalten). Für die Anfrage
         wird ein Kontakt der erziehungsberechtigten Person verwendet oder
         angelegt. Die Speicherdauer ist eine offene Kundenentscheidung
         (TODO(KJR) Aufbewahrungsfrist) und steht deshalb noch nicht im Text. -->
    <template id="registration_attendee_details_kjr_sign_privacy"
              inherit_id="kjr_event.registration_attendee_details_kjr_privacy"
              name="KJR Anmeldung: Datenschutzhinweis digitale Einwilligung">
        <xpath expr="//t[@name='kjr_consent_privacy_extra']" position="inside">
            <t t-if="event.kjr_consent_mode == 'sign'">
                <p class="small mb-0 mt-2">Bei Teilnehmenden unter 18 Jahren holen wir die
                    Einwilligung über unser System zur digitalen Unterschrift ein. Das
                    unterschriebene Dokument wird als Nachweis der Einwilligung in diesem
                    System gespeichert. Für die erziehungsberechtigte Person speichern wir
                    dazu einen Kontakt mit Name und E-Mail-Adresse.</p>
            </t>
        </xpath>
    </template>

    <!-- Erfolgsseite: Zusatzhinweis zur Unterschriftsanfrage. Anker
         <t name="kjr_consent_complete_extra"/> liefert kjr_event im Template
         registration_complete_kjr_consent_hint (Schnittstelle). -->
    <template id="registration_complete_kjr_sign_hint"
              inherit_id="kjr_event.registration_complete_kjr_consent_hint"
              name="KJR Anmeldung: Hinweis digitale Unterschrift">
        <xpath expr="//t[@name='kjr_consent_complete_extra']" position="inside">
            <t t-if="event.kjr_consent_mode == 'sign'">
                <p class="mb-0 mt-2">Bitte prüfen Sie auch den Spam-Ordner. Ist die Anfrage an
                    die E-Mail-Adresse Ihres Kundenkontos gegangen, finden Sie sie auch unter
                    Mein Konto bei „Signaturanfragen“.</p>
            </t>
        </xpath>
    </template>

</odoo>
