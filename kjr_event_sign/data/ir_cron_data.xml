<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate="1": Intervall und aktiv-Schalter bleiben so, wie die
         Geschäftsstelle sie einstellt. Der Lauf ist billig, solange es keine
         gesperrten Anmeldungen und keine offenen Anfragen gibt. -->
    <data noupdate="1">

        <!-- Täglich: fehlgeschlagene Unterschriftsanfragen erneut versuchen
             (höchstens drei Versuche), bei Ablauf oder Ablehnung einmalig eine
             Aktivität anlegen, verwaiste Anfragen (Anmeldung gelöscht oder
             abgesagt) stornieren.
             TODO(KJR): Automatische Absage bei Ablauf oder Ablehnung ist offen;
             heute entscheidet die Geschäftsstelle über die Aktivität. -->
        <record id="cron_kjr_event_sign" model="ir.cron">
            <field name="name">KJR Einwilligung: Unterschriftsanfragen nachhalten</field>
            <field name="model_id" ref="event.model_event_registration"/>
            <field name="state">code</field>
            <field name="code">model._cron_kjr_event_sign()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
