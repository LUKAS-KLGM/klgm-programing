<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate="1": geplante Aktionen bleiben so, wie die Geschäftsstelle sie
         eingestellt hat (Intervall/aktiv), und werden bei Updates nicht
         zurückgesetzt.
         Beide Crons laufen ins Leere, solange der jeweilige Vorlauf in den
         Systemparametern 0 ist (Default) – siehe data/ir_config_parameter_data.xml. -->
    <data noupdate="1">

        <record id="cron_kjr_event_consent_reminder" model="ir.cron">
            <field name="name">KJR Veranstaltung: Einwilligungs-Erinnerung</field>
            <field name="model_id" ref="event.model_event_registration"/>
            <field name="state">code</field>
            <field name="code">model._cron_kjr_consent_reminder()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <record id="cron_kjr_event_packing_list" model="ir.cron">
            <field name="name">KJR Veranstaltung: Packliste vor Anreise</field>
            <field name="model_id" ref="event.model_event_registration"/>
            <field name="state">code</field>
            <field name="code">model._cron_kjr_packing_list()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

    </data>
</odoo>
