<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- E4: Übersicht der zugeordneten KJR-Veranstaltungen -->
    <!-- Kachel auf der Portalseite „Mein Konto" (/my).
         Ohne sie war die Kooperationspartner-Ansicht nur über die direkte URL
         erreichbar. Bewusst mit t-if auf den Zähler: ein Portalnutzer, der kein
         Kooperationspartner ist (z. B. ein Mitgliedsverband mit Zuschussanträgen),
         soll keine leere Rubrik „KJR-Veranstaltungen 0" sehen. -->
    <template id="portal_my_home_kjr_event" name="Portal: KJR-Veranstaltungen"
              inherit_id="portal.portal_my_home" customize_show="True" priority="44">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-if="kjr_event_count">
                <t t-call="portal.portal_docs_entry">
                    <t t-set="title">KJR-Veranstaltungen</t>
                    <t t-set="url" t-value="'/my/kjr-events'"/>
                    <t t-set="placeholder_count" t-value="'kjr_event_count'"/>
                </t>
            </t>
        </xpath>
    </template>

    <template id="portal_kjr_events" name="KJR Kooperationspartner – Veranstaltungen">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <div class="o_portal_my_doc_table">
                <h3 class="mb-3">Meine KJR-Veranstaltungen</h3>
                <t t-if="not events">
                    <div class="alert alert-info" role="alert">
                        Ihnen sind aktuell keine Veranstaltungen zugeordnet.
                    </div>
                </t>
                <t t-if="events">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Veranstaltung</th>
                                <th>Beginn</th>
                                <th>Ende</th>
                                <th class="text-end">Teilnehmer/innen</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="events" t-as="event">
                                <td>
                                    <a t-attf-href="/my/kjr-events/#{event.id}/teilnehmer">
                                        <t t-esc="event.name"/>
                                    </a>
                                </td>
                                <td>
                                    <span t-field="event.date_begin"
                                          t-options='{"format": "dd.MM.yyyy"}'/>
                                </td>
                                <td>
                                    <span t-field="event.date_end"
                                          t-options='{"format": "dd.MM.yyyy"}'/>
                                </td>
                                <td class="text-end">
                                    <t t-esc="event.seats_taken"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </t>
            </div>
        </t>
    </template>

    <!-- E4: Teilnehmerliste einer Veranstaltung (externe Kooperationspartner)

         Datenschutz (Befund K4, Audit 21.08.2026): Empfaenger dieser Seite sind
         EXTERNE Stellen. Ausgegeben wird deshalb nur, was fuer die Durchfuehrung
         der Massnahme erforderlich ist: Name, Alter, Status. Bewusst NICHT
         ausgegeben werden Gesundheits- und Kontaktangaben, insbesondere der
         Ernaehrungs-Freitext (dietary_note, dort landen Allergien im Klartext)
         und das Bemerkungsfeld (notes, unstrukturierter Freitext). Ebenfalls
         entfernt: der Stand der Einwilligung der Erziehungsberechtigten samt
         Erinnerungsdatum - das ist ein interner Vorgang zwischen KJR und
         Familie und fuer die Durchfuehrung durch einen Externen ohne Belang.
         Die Ernaehrung erscheint ausschliesslich als Anzahl je Kategorie ohne
         Namensbezug (siehe _kjr_portal_dietary_summary im Controller).
         Der Controller arbeitet ohne sudo(), damit ein Feldschutz (groups=)
         serverseitig greift; die Vorlage erhaelt nur vorbereitete Werte und
         kein Recordset, ueber das weitere Felder nachgeladen werden koennten. -->
    <template id="portal_kjr_event_attendees" name="KJR Kooperationspartner – Teilnehmer/innen">
        <t t-call="portal.portal_layout">
            <div class="o_portal_my_doc_table">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h3 class="mb-0">
                        Teilnehmer/innen – <t t-esc="event.name"/>
                    </h3>
                    <a href="/my/kjr-events" class="btn btn-sm btn-secondary">Zurück</a>
                </div>
                <div class="alert alert-warning" role="alert">
                    <strong>Hinweis zum Datenschutz:</strong>
                    Diese Liste enthält personenbezogene Daten von Minderjährigen.
                    Sie darf ausschließlich für die Durchführung dieser Maßnahme
                    verwendet werden – nicht für andere Zwecke, nicht zur
                    Weitergabe an Dritte und nicht länger als für die
                    Durchführung erforderlich. Bitte drucken Sie die Liste nur bei
                    Bedarf aus und vernichten Sie Ausdrucke nach der Maßnahme.
                </div>
                <t t-if="not attendees">
                    <div class="alert alert-info" role="alert">
                        Für diese Veranstaltung liegen keine bestätigten Anmeldungen vor.
                    </div>
                </t>
                <t t-if="attendees">
                    <table class="table table-sm table-striped">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Alter</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="attendees" t-as="row">
                                <td><t t-esc="row['name']"/></td>
                                <td>
                                    <t t-if="row['age'] is not None"><t t-esc="row['age']"/></t>
                                </td>
                                <td><t t-esc="row['state_label']"/></td>
                            </tr>
                        </tbody>
                    </table>
                    <p class="text-muted small">
                        Angezeigt werden ausschließlich bestätigte Anmeldungen.
                        Abgesagte Anmeldungen und Wartelistenplätze sind nicht enthalten.
                    </p>
                    <!-- Verpflegung nur als Summe je Kategorie: der Kooperations-
                         partner erfährt, wie viele Portionen zu planen sind, aber
                         nicht, wer welche Angabe gemacht hat. -->
                    <t t-if="dietary_summary">
                        <h5 class="mt-4">Verpflegung – Übersicht</h5>
                        <table class="table table-sm w-auto">
                            <tbody>
                                <tr t-foreach="dietary_summary" t-as="item">
                                    <td><t t-esc="item['label']"/></td>
                                    <td class="text-end"><t t-esc="item['count']"/></td>
                                </tr>
                            </tbody>
                        </table>
                        <p class="text-muted small">
                            Ohne Namenszuordnung. Einzelheiten zu Allergien und
                            Unverträglichkeiten erfragen Sie bitte bei der
                            Geschäftsstelle des KJR.
                        </p>
                    </t>
                </t>
            </div>
        </t>
    </template>

</odoo>
