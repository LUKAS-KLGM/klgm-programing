<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- E1: KJR-Felder in das Online-Anmeldeformular einfügen -->
    <template id="registration_attendee_details_kjr"
              inherit_id="website_event.registration_attendee_details"
              name="KJR Anmeldedetails">
        <xpath expr="//t[@name='attendee_loop']" position="inside">
            <div class="row g-2 mt-2 o_kjr_attendee_fields">
                <div class="col-md-4">
                    <label t-attf-for="#{counter}-birthdate" class="form-label">Geburtsdatum</label>
                    <input type="date" class="form-control"
                           t-attf-name="#{counter}-birthdate"
                           t-attf-id="#{counter}-birthdate"/>
                </div>
                <div class="col-md-4">
                    <label t-attf-for="#{counter}-dietary_requirements" class="form-label">Ernährung</label>
                    <select class="form-select"
                            t-attf-name="#{counter}-dietary_requirements"
                            t-attf-id="#{counter}-dietary_requirements">
                        <option value="">-</option>
                        <option value="none">Keine besonderen</option>
                        <option value="vegetarian">Vegetarisch</option>
                        <option value="vegan">Vegan</option>
                        <option value="halal">Halal</option>
                        <option value="kosher">Koscher</option>
                        <option value="allergy">Allergie/Unverträglichkeit</option>
                        <option value="other">Sonstiges</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label t-attf-for="#{counter}-dietary_note" class="form-label">Ernährung – Hinweis</label>
                    <input type="text" class="form-control"
                           t-attf-name="#{counter}-dietary_note"
                           t-attf-id="#{counter}-dietary_note"
                           placeholder="z. B. Nussallergie"/>
                </div>
                <div class="col-md-6">
                    <label t-attf-for="#{counter}-guardian_name" class="form-label">Erziehungsberechtigte/r</label>
                    <input type="text" class="form-control"
                           t-attf-name="#{counter}-guardian_name"
                           t-attf-id="#{counter}-guardian_name"/>
                </div>
                <div class="col-md-6">
                    <label t-attf-for="#{counter}-guardian_phone" class="form-label">Telefon Erziehungsberechtigte/r</label>
                    <input type="text" class="form-control"
                           t-attf-name="#{counter}-guardian_phone"
                           t-attf-id="#{counter}-guardian_phone"/>
                </div>
                <div class="col-md-6">
                    <label t-attf-for="#{counter}-emergency_contact" class="form-label">Notfallkontakt</label>
                    <input type="text" class="form-control"
                           t-attf-name="#{counter}-emergency_contact"
                           t-attf-id="#{counter}-emergency_contact"/>
                </div>
                <div class="col-md-6 d-flex align-items-end">
                    <div class="form-check">
                        <input type="checkbox" class="form-check-input" value="1"
                               t-attf-name="#{counter}-parental_consent"
                               t-attf-id="#{counter}-parental_consent"/>
                        <label class="form-check-label" t-attf-for="#{counter}-parental_consent">
                            Einwilligung der Erziehungsberechtigten liegt vor
                        </label>
                    </div>
                </div>
                <div class="col-12">
                    <label t-attf-for="#{counter}-notes" class="form-label">Bemerkungen</label>
                    <textarea class="form-control" rows="2"
                              t-attf-name="#{counter}-notes"
                              t-attf-id="#{counter}-notes"/>
                </div>
            </div>
        </xpath>
    </template>

    <!-- E12: Treffpunkt, Wichtig, Webseite (Nupian-Parität) -->
    <template id="event_description_full_kjr_meeting_info"
              name="KJR: Treffpunkt, Wichtig, Webseite"
              inherit_id="website_event.event_description_full">
        <!-- "Wichtig" ist bewusst KEIN an-/abschaltbarer Sidebar-Block: ein wichtiger
             Hinweis soll nicht versehentlich per Website-Editor-Toggle verschwinden
             können. Immer sichtbar, sobald das Feld befüllt ist – oberhalb der
             eigentlichen Beschreibung, analog zu den Alert-Boxen im Backend-Formular. -->
        <xpath expr="//div[@t-field='event.description']" position="before">
            <div t-if="event.kjr_important_note" class="alert alert-warning mb-3" role="alert"
                 t-field="event.kjr_important_note"/>
        </xpath>
        <!-- "Treffpunkt" und "Webseite" gehören inhaltlich zum Ort-Block dazu (Ziel +
             Treffpunkt + weiterführender Link) und teilen sich daher dessen bestehenden
             Toggle (opt_event_location_block) statt einen eigenen zu bekommen. -->
        <xpath expr="//a[@t-att-href=&quot;event._google_map_link()&quot;]" position="after">
            <div t-if="event.kjr_meeting_point" class="mt-3">
                <h6 class="o_wevent_sidebar_title">Treffpunkt</h6>
                <p class="mb-0" t-field="event.kjr_meeting_point"/>
            </div>
            <div t-if="event.kjr_website_url" class="mt-3">
                <a t-att-href="event.kjr_website_url" target="_blank" rel="noopener">
                    <i class="fa fa-external-link me-1" role="presentation"/>Webseite
                </a>
            </div>
        </xpath>
    </template>

    <!-- E11: Dokumente-Block (Sidebar) -->

    <!-- Reiner Toggle-Marker: aktiv/inaktiv wird von den Website-Builder-Optionen
         (siehe static/src/website_builder/event_documents_option.xml) über die
         View-Aktivierung dieses (leeren) Templates gesteuert, exakt wie bei
         website_event.opt_event_location_block/opt_event_organizer_block/... . -->
    <template id="opt_event_kjr_documents_block"
              name="KJR Dokumente-Block"
              inherit_id="website_event.event_description_full"
              active="True"/>

    <!-- Tatsächliche Markup-Erweiterung: Flag setzen + Sidebar-Sichtbarkeit + Inhalt. -->
    <template id="event_description_full_kjr_documents"
              name="KJR: Dokumente in Event-Beschreibung"
              inherit_id="website_event.event_description_full">
        <xpath expr="//t[@t-set='opt_event_share_block']" position="after">
            <t t-set="opt_event_kjr_documents_block"
               t-value="is_view_active('kjr_event.opt_event_kjr_documents_block')"/>
        </xpath>
        <xpath expr="//aside[@id='o_wevent_event_main_sidebar']" position="attributes">
            <attribute name="t-if">opt_event_registration_block or opt_event_dates_block or opt_event_calendar_block or
                opt_event_location_block or opt_event_organizer_block or opt_event_share_block or opt_event_kjr_documents_block</attribute>
        </xpath>
        <xpath expr="//div[@t-if='opt_event_share_block']" position="before">
            <div t-if="opt_event_kjr_documents_block and event.kjr_document_ids"
                 class="o_wevent_sidebar_block o_wevent_bordered_block pb-3 mb-4">
                <div>
                    <h6 class="o_wevent_sidebar_title">Dokumente</h6>
                </div>
                <ul class="list-unstyled mb-0">
                    <li t-foreach="event.kjr_document_ids" t-as="kjr_doc" class="mb-1">
                        <a t-att-href="kjr_doc.download_url" target="_blank" rel="noopener"
                           t-att-title="kjr_doc.name">
                            <i class="fa fa-file-pdf-o me-2" role="presentation"/>
                            <span t-out="kjr_doc.name"/>
                        </a>
                    </li>
                </ul>
            </div>
        </xpath>
    </template>

    <!-- ================================================================
         E14 – Altersfilter auf der öffentlichen Veranstaltungsübersicht
         ================================================================
         Eltern sollen auf einen Blick sehen, welche Freizeiten zum Alter ihres Kindes
         passen, statt jede Veranstaltung einzeln zu öffnen.

         Umsetzung bewusst OHNE JavaScript als reine Links mit GET-Parameter
         (?alter=11-13). Damit bleibt die Seite teilbar, indexierbar und funktioniert
         auch ohne aktives JS. Welche Gruppen erscheinen, entscheidet der Controller
         anhand der real gepflegten Altersangaben (siehe controllers/website_event.py).
    -->
    <template id="index_topbar_kjr_age_filter"
              name="KJR: Altersfilter Veranstaltungsübersicht"
              inherit_id="website_event.index_topbar">
        <xpath expr="//section[hasclass('o_wevent_index_topbar_filters')]" position="after">
            <section t-if="kjr_age_groups" class="o_kjr_age_filter d-print-none mb-3">
                <div class="d-flex flex-wrap align-items-center gap-2">
                    <span class="fw-bold me-1">Alter des Kindes:</span>
                    <!-- "Alle anzeigen" entfernt den Parameter wieder: QueryURL lässt
                         leere Werte weg, dadurch ist der Filter zurückgesetzt. -->
                    <a t-att-href="keep_event_url('/event', alter='')"
                       t-attf-class="btn btn-sm #{'btn-primary' if not kjr_age_filter else 'btn-light'}">
                        Alle anzeigen
                    </a>
                    <a t-foreach="kjr_age_groups" t-as="kjr_age_group"
                       t-att-href="keep_event_url('/event', alter=kjr_age_group['key'])"
                       t-attf-class="btn btn-sm #{'btn-primary' if kjr_age_group['key'] == kjr_age_filter else 'btn-light'}">
                        <t t-out="kjr_age_group['label']"/>
                        <span t-if="kjr_age_group['count']"
                              class="badge text-bg-light ms-1"
                              t-out="kjr_age_group['count']"/>
                    </a>
                </div>
                <!-- Aktiver Filter bleibt sichtbar und ist jederzeit zurücksetzbar. -->
                <div t-if="kjr_age_filter" class="small text-muted mt-2">
                    Angezeigt werden Veranstaltungen für
                    <strong t-out="kjr_age_filter_label"/>
                    sowie Veranstaltungen ohne Altersangabe.
                    <a t-att-href="keep_event_url('/event', alter='')" class="ms-1">Filter zurücksetzen</a>
                </div>
            </section>
        </xpath>
    </template>

    <!-- ================================================================
         E15 – Wording: "Tickets"/"Registrieren" -> "Anmeldung"/"Anmelden"
         ================================================================
         Der KJR hat den Ticket-Begriff ausdrücklich abgelehnt: es geht um Anmeldungen
         zu Freizeiten und Schulungen, nicht um Ticketverkauf.

         Umsetzung über Template-Vererbung statt über eine eigene .po-Datei — modulfremde
         Kernbegriffe lassen sich über eine eigene Übersetzungsdatei nicht zuverlässig
         überschreiben (ein späteres `-u website_event` würde sie wieder überschreiben).

         Alle Stellen sind über `event.is_kjr` eingegrenzt: Fremdveranstaltungen behalten
         das Ticket-Wording. Der t-else-Zweig führt dabei bewusst den heutigen DEUTSCHEN
         Text mit (z. B. "Tickets erhalten") statt des englischen Odoo-Originals — der
         Text steht ab jetzt in einem kjr_event-View-Record, für den es keine
         website_event-Übersetzung gibt; mit dem englischen Original würde für
         Fremdveranstaltungen plötzlich Englisch erscheinen. Deutsch direkt im Code ist
         zudem der Projektstandard dieser Module.

         ROBUSTHEIT / UPGRADE-HINWEIS (bitte bei JEDEM Odoo-Update abarbeiten):
         * Alle Ersetzungen laufen mit position="replace" mode="inner". Damit wird
           ausschließlich der INHALT des Zielknotens getauscht; das Element selbst
           inklusive seiner Attribute (t-if/t-elif, Klassen, href, id, disabled …)
           stammt weiterhin aus dem Kern. Künftige Kernverbesserungen an diesen
           Attributen bleiben also erhalten — anders als beim früheren Voll-Ersatz
           (mode="outer"), der den kompletten Knoten wortgetreu kopieren musste.
         * Die xpath-Selektoren nutzen ausschließlich nicht-übersetzbare Attribute
           (id, class, type, t-if/t-elif/t-else, data-bs-*) — niemals
           string=/title=/alt=/placeholder=. Jeder Selektor ist zusätzlich an einen
           stabilen Anker (Kern-id oder eindeutige Kernklasse) gebunden und trifft im
           Zieltemplate genau EIN Element. Trifft ein Selektor nach einem Update kein
           Element mehr, schlägt das Update hörbar fehl ("Element cannot be located in
           parent view") — das ist gewollt und deutlich besser als eine stille
           Fehlplatzierung.
         * Prüfliste nach einem Update: (a) greifen die Anker unten noch, (b) lautet der
           Kerntext im t-else-Zweig (Fremdveranstaltungen) noch so wie hier hinterlegt,
           (c) sind im Kern neue Ticket-Formulierungen dazugekommen?
         Referenz Odoo 19: addons/website_event/views/event_templates_list.xml und
         addons/website_event/views/event_templates_page_registration.xml.

         TODO(Kunde): Der Verkaufsbegriff "Ausverkauft" (Sold Out) steht weiterhin an
         mehreren Stellen der Liste und des Dialogs. Er stand am 23.07.2026 nicht auf der
         Liste und wurde deshalb bewusst NICHT angefasst. Für kostenfreie Freizeiten wäre
         "Ausgebucht" sachlich richtiger — bitte entscheiden lassen, dann analog zu den
         Blöcken hier ergänzen.
    -->

    <!-- Übersichtsseite: Karten-CTA und Teilnahme-Badge

         Kerntemplate: website_event.events_list (event_templates_list.xml).
         Ersetzt werden zwei Texte: der CTA-Button "Tickets erhalten" (Kern: "Get Tickets")
         und das Teilnahme-Badge "Registriert" (Kern: "Registered").
         Grund: Kundenentscheidung 23.07.2026 — "Tickets" ist für Freizeit-Anmeldungen der
         falsche Begriff.
         NACH EINEM ODOO-UPDATE PRÜFEN (siehe Prüfliste im Kopfkommentar oben). -->
    <template id="events_list_kjr_wording"
              name="KJR: Wording Veranstaltungsliste"
              inherit_id="website_event.events_list">
        <!-- "Tickets erhalten" -> "Zur Anmeldung".
             Anker: der Kern hat im CTA-Block zwei Buttons — "Event Info" (btn-light) im
             t-if-Zweig "Anmeldung geschlossen" und den gesuchten btn-primary im
             t-else-Zweig "Anmeldung offen". Der Selektor bindet daher an <main> +
             t-else-Zweig + btn-primary und trifft damit genau diesen einen Button.
             mode="inner": Klassen und type des Kern-Buttons bleiben unangetastet. -->
        <xpath expr="//main//t[@t-else]/button[hasclass('btn-primary')]"
               position="replace" mode="inner">
            <t t-if="event.is_kjr">Zur Anmeldung</t>
            <t t-else="">Tickets erhalten</t>
            <i class="fa fa-chevron-right"/>
        </xpath>
        <!-- "Registriert" -> "Angemeldet".
             Anker: die eindeutige Kernklasse o_wevent_participating.
             mode="inner": t-if="event.is_participating" und die Positionierungsklassen
             des Kerns bleiben erhalten. -->
        <xpath expr="//small[hasclass('o_wevent_participating')]"
               position="replace" mode="inner">
            <i class="fa fa-check me-2"/>
            <t t-if="event.is_kjr">Angemeldet</t>
            <t t-else="">Registriert</t>
        </xpath>
    </template>

    <!-- Detailseite: Anmelde-CTA in Seitenleiste und Mobil-Block

         Kerntemplate: website_event.registration_template (event_templates_page_registration.xml).
         Ersetzt werden drei Texte: "Registrieren" auf beiden CTA-Varianten (Link zur
         Anmeldeseite bzw. Button, der den Auswahldialog öffnet) und die Fehlermeldung
         "Diese Tickets sind nicht mehr verfügbar".
         Grund: Kundenentscheidung 23.07.2026.
         NACH EINEM ODOO-UPDATE PRÜFEN (siehe Prüfliste im Kopfkommentar oben). -->
    <template id="registration_template_kjr_wording"
              name="KJR: Wording Anmelde-Button"
              inherit_id="website_event.registration_template">
        <!-- CTA-Variante 1 (Link auf /event/<id>/register).
             Anker: einziger <a type="button"> mit dynamischem href im Template.
             mode="inner" lässt t-if, Klassen und vor allem die href-Berechnung beim
             Kern — der frühere Voll-Ersatz musste sie kopieren. -->
        <xpath expr="//a[@type='button'][@t-att-href]"
               position="replace" mode="inner">
            <t t-if="event.is_kjr">Jetzt anmelden</t>
            <t t-else="">Registrieren</t>
        </xpath>
        <!-- CTA-Variante 2 (öffnet den Auswahldialog).
             Anker: einziger <button type="button"> mit data-bs-toggle="modal".
             Dank mode="inner" bleibt das t-elif des Kerns erhalten (es hängt am
             vorhergehenden <a>) und muss hier nicht mehr wiederholt werden. -->
        <xpath expr="//button[@type='button'][@data-bs-toggle='modal']"
               position="replace" mode="inner">
            <t t-if="event.is_kjr">Jetzt anmelden</t>
            <t t-else="">Registrieren</t>
        </xpath>
        <!-- Fehlermeldung "zu wenige freie Plätze".
             Anker: exakte t-if-Bedingung des Kerns (nicht übersetzbar, eindeutig).
             mode="inner": alert-Klassen und role="alert" bleiben Kernsache. -->
        <xpath expr="//div[@t-if=&quot;registration_error_code == 'insufficient_seats'&quot;]"
               position="replace" mode="inner">
            <t t-if="event.is_kjr">Anmeldung fehlgeschlagen! Für diese Veranstaltung sind keine Plätze mehr frei.</t>
            <t t-else="">Die Anmeldung ist fehlgeschlagen! Diese Tickets sind nicht mehr verfügbar.</t>
        </xpath>
    </template>

    <!-- Auswahl-Dialog (im Standard "Tickets")

         Kerntemplate: website_event.modal_ticket_registration (event_templates_page_registration.xml).
         Ersetzt werden vier Texte: der Dialogtitel "Tickets", die Fehlermeldung bei zu
         wenigen freien Plätzen, die Fallback-Bezeichnung "Registrierung" (wenn keine
         Ticketart gepflegt ist) und der Absende-Button "Registrieren" — letzterer
         existiert im Kern ZWEIMAL (Zweig "mehrere Ticketarten" und Zweig "eine bzw.
         keine Ticketart"), beide Zweige werden unten getrennt und eindeutig adressiert.
         Grund: Kundenentscheidung 23.07.2026.
         NACH EINEM ODOO-UPDATE PRÜFEN (siehe Prüfliste im Kopfkommentar oben). -->
    <template id="modal_ticket_registration_kjr_wording"
              name="KJR: Wording Anmeldedialog"
              inherit_id="website_event.modal_ticket_registration">
        <!-- Dialogtitel "Tickets" -> "Anmeldung".
             Anker: Kern-id staticBackdropLabelTicket (wird vom aria-labelledby des
             Modals referenziert und ist daher besonders stabil). -->
        <xpath expr="//div[@id='staticBackdropLabelTicket']"
               position="replace" mode="inner">
            <t t-if="event.is_kjr">Anmeldung</t>
            <t t-else="">Tickets</t>
        </xpath>
        <!-- Fehlermeldung "zu wenige freie Plätze".
             Anker: Kern-id o_wevent_tickets + exakte t-if-Bedingung der Alert-Box.
             Der frühere Selektor //div[@id='o_wevent_tickets']/div[@t-if] hätte jedes
             beliebige neue Bedingungs-<div> an dieser Stelle getroffen.
             Ersetzt wird zudem nur noch der Textabsatz, nicht die Alert-Box. -->
        <xpath expr="//div[@id='o_wevent_tickets']//div[@t-if=&quot;registration_error_code == 'insufficient_seats'&quot;]/p"
               position="replace" mode="inner">
            <t t-if="event.is_kjr">Anmeldung fehlgeschlagen! Für diese Veranstaltung sind keine Plätze mehr frei.</t>
            <t t-else="">Die Anmeldung ist fehlgeschlagen! Diese Tickets sind nicht mehr verfügbar.</t>
        </xpath>
        <!-- Fallback-Bezeichnung, wenn keine Ticketart gepflegt ist.
             Anker: eindeutige Kernklasse o_wevent_single_ticket_name + t-else-Zweig
             (der t-if-Zweig zeigt den Namen der Ticketart). -->
        <xpath expr="//h5[hasclass('o_wevent_single_ticket_name')]/span[@t-else]"
               position="replace" mode="inner">
            <t t-if="event.is_kjr">Anmeldung</t>
            <t t-else="">Registrierung</t>
        </xpath>
        <!-- Absende-Button, Zweig "mehrere Ticketarten".
             Anker: modal-footer als direktes Folgegeschwister des Ticket-Collapse
             (Kern-id o_wevent_tickets_collapse). Die zusätzliche Klassenbedingung
             hält den Selektor auch dann eindeutig, wenn der Kern ein weiteres
             Geschwister-<div> ergänzt.
             mode="inner": disabled="" und t-attf-id des Kerns bleiben erhalten. -->
        <xpath expr="//div[@id='o_wevent_tickets_collapse']/following-sibling::div[hasclass('modal-footer')]/button[@type='submit']"
               position="replace" mode="inner">
            <t t-if="event.is_kjr">Weiter zur Anmeldung</t>
            <t t-else="">Registrieren</t>
            <t t-if="event.seats_limited and event.seats_max and event.seats_available &lt;= (event.seats_max * 0.2)">
                <t t-if="event.is_kjr">(nur noch <t t-out="event.seats_available"/> Plätze frei)</t>
                <t t-else="">(nur <t t-out="event.seats_available"/> verfügbar)</t>
            </t>
        </xpath>
        <!-- Absende-Button, Zweig "genau eine bzw. keine Ticketart".
             Anker: eindeutige Kernklasse o_wevent_registration_single + deren
             modal-footer. Ohne die footer-Bedingung wäre der Selektor mehrdeutig,
             sobald der Kern in diesem Block einen weiteren Submit-Button erhält.
             mode="inner": disabled="disabled" und t-attf-id des Kerns bleiben erhalten. -->
        <xpath expr="//div[hasclass('o_wevent_registration_single')]//div[hasclass('modal-footer')]/button[@type='submit']"
               position="replace" mode="inner">
            <t t-if="event.is_kjr">Weiter zur Anmeldung</t>
            <t t-else="">Registrieren</t>
            <t t-if="event.seats_limited and event.seats_max and event.seats_available &lt;= (event.seats_max * 0.2)">
                <t t-if="event.is_kjr">(nur noch <t t-out="event.seats_available"/> Plätze frei)</t>
                <t t-else="">(nur <t t-out="event.seats_available"/> verfügbar)</t>
            </t>
        </xpath>
    </template>

    <!-- Teilnehmerformular (im Standard "Ticket #1", "Registrierung bestätigen")

         Kerntemplate: website_event.registration_attendee_details (event_templates_page_registration.xml).
         Ersetzt werden fünf Texte: die Dialogüberschrift "Teilnehmer", die Zwischen-
         überschrift "Ticket-Nr. n", die beiden Hinweise zu zu wenigen freien Plätzen und
         der Absende-Button "Registrierung bestätigen".
         Grund: Kundenentscheidung 23.07.2026.
         NACH EINEM ODOO-UPDATE PRÜFEN (siehe Prüfliste im Kopfkommentar oben). -->
    <template id="registration_attendee_details_kjr_wording"
              name="KJR: Wording Teilnehmerformular"
              inherit_id="website_event.registration_attendee_details">
        <!-- Dialogüberschrift.
             Anker: modal-title innerhalb des modal-header (der Dialog hat genau einen
             Kopfbereich). Der frühere Selektor band nur an die Klasse modal-title. -->
        <xpath expr="//div[hasclass('modal-header')]/h4[hasclass('modal-title')]"
               position="replace" mode="inner">
            <t t-if="event.is_kjr">Teilnehmer/innen</t>
            <t t-else="">Teilnehmer</t>
        </xpath>
        <!-- Zwischenüberschrift je Teilnehmer/in.
             Anker: exakte t-if-Bedingung des Kern-Blocks + dessen einzige h5.
             mode="inner": das t-attf-class des Kerns (border-bottom nur bei
             vorhandenen Fragen) muss nicht mehr kopiert werden. -->
        <xpath expr="//div[@t-if='event.specific_question_ids']/h5"
               position="replace" mode="inner">
            <t t-if="event.is_kjr">Anmeldung Nr. <span t-out="counter"/></t>
            <t t-else="">Ticket-Nr. <span t-out="counter"/></t>
            <small class="text-muted">- <span t-out="ticket['name']"/></small>
        </xpath>
        <!-- Hinweis "mehr Plätze angefordert als das Limit erlaubt".
             Anker: exakte t-if-Bedingung des Kern-Blocks; darin gibt es genau ein
             <strong>. -->
        <xpath expr="//t[@t-if='not limit_check']//strong"
               position="replace" mode="inner">
            <t t-if="event.is_kjr">Es können nicht mehr Anmeldungen erfasst werden, als Plätze frei sind.</t>
            <t t-else="">Es ist nicht möglich, mehr Plätze zu reservieren, als verfügbar sind.</t>
        </xpath>
        <!-- Hinweis "mehr Anmeldungen als freie Plätze".
             Anker: exakte t-elif-Bedingung des Kern-Blocks; darin gibt es genau ein
             <strong>. -->
        <xpath expr="//t[@t-elif='not availability_check and limit_check']//strong"
               position="replace" mode="inner">
            <t t-if="event.is_kjr">Sie haben mehr Anmeldungen angefordert, als Plätze frei sind.</t>
            <t t-else="">Sie haben mehr Tickets bestellt als Plätze verfügbar sind.</t>
        </xpath>
        <!-- Absende-Button.
             Anker: Submit-Button im modal-footer. Der frühere Selektor //button[@type='submit']
             hätte jeden künftig ergänzten Submit-Button im Formular treffen können.
             mode="inner": t-if="availability_check and limit_check" bleibt Kernsache. -->
        <xpath expr="//div[hasclass('modal-footer')]/button[@type='submit']"
               position="replace" mode="inner">
            <t t-if="event.is_kjr">Anmeldung abschicken</t>
            <t t-else="">Registrierung bestätigen</t>
        </xpath>
    </template>

    <!-- Bestätigungsseite nach abgeschickter Anmeldung

         Kerntemplate: website_event.registration_complete (event_templates_page_registration.xml).
         Ersetzter Text: die Seitenüberschrift "Registrierung bestätigt!".
         Grund: Kundenentscheidung 23.07.2026.
         NACH EINEM ODOO-UPDATE PRÜFEN (siehe Prüfliste im Kopfkommentar oben). -->
    <template id="registration_complete_kjr_wording"
              name="KJR: Wording Anmeldebestätigung"
              inherit_id="website_event.registration_complete">
        <!-- Anker: eindeutige Kernklasse o_wereg_confirmed (Container der
             Bestätigungsseite) + die einzige h1 darin. -->
        <xpath expr="//div[hasclass('o_wereg_confirmed')]//h1[hasclass('h3-fs')]"
               position="replace" mode="inner">
            <t t-if="event.is_kjr">Anmeldung bestätigt!</t>
            <t t-else="">Registrierung bestätigt!</t>
        </xpath>
    </template>

    <!-- Download der Bestätigung (im Standard "Tickets herunterladen")

         Kerntemplate: website_event.registration_ticket_access (event_templates_page_registration.xml).
         Ersetzt werden Linktext und title-Tooltip des Download-Buttons.
         Grund: Kundenentscheidung 23.07.2026.
         NACH EINEM ODOO-UPDATE PRÜFEN (siehe Prüfliste im Kopfkommentar oben). -->
    <template id="registration_ticket_access_kjr_wording"
              name="KJR: Wording Bestätigungs-Download"
              inherit_id="website_event.registration_ticket_access">
        <!-- Anker (beide xpaths): eindeutige Kernklasse o_wevent_registration_ticket_access
             + exakte t-if-Bedingung des Download-Links. Der zweite Link im Kern
             ("Online teilnehmen") hängt an t-else und wird dadurch sicher nicht getroffen.

             Schritt 1: statisches title="Download All Tickets" des Kerns entfernen
             (leeres <attribute> löscht das Attribut) und durch eine KJR-abhängige
             Variante ersetzen. Der Selektor selbst nutzt KEIN übersetzbares Attribut. -->
        <xpath expr="//div[hasclass('o_wevent_registration_ticket_access')]//a[@t-if='event.address_id']"
               position="attributes">
            <attribute name="title"/>
            <attribute name="t-att-title">'Anmeldebestätigung herunterladen' if event.is_kjr else 'Alle Tickets herunterladen'</attribute>
        </xpath>
        <!-- Schritt 2: nur den Linktext ersetzen. mode="inner" hält insbesondere die
             href-Berechnung mit _get_tickets_access_hash() beim Kern — sie musste beim
             früheren Voll-Ersatz kopiert werden und wäre bei einer Kernänderung
             stillschweigend veraltet. -->
        <xpath expr="//div[hasclass('o_wevent_registration_ticket_access')]//a[@t-if='event.address_id']"
               position="replace" mode="inner">
            <t t-if="event.is_kjr">Anmeldebestätigung herunterladen</t>
            <t t-else="">Tickets herunterladen</t>
        </xpath>
    </template>

</odoo>
