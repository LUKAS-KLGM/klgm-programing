<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- "Communication" ist im deutschen Odoo als "Mitteilungen" uebersetzt.
         Gemeint ist der Verwendungszweck der Ueberweisung, also die Referenz. -->
    <template id="payment_confirmation_status_kjr_reference"
              inherit_id="website_sale.payment_confirmation_status"
              name="KJR: Referenz statt Mitteilungen (Shop)">
        <xpath expr="//div[@id='order_reference']/b" position="replace">
            <b>Referenz (Verwendungszweck): </b>
        </xpath>
    </template>

    <template id="custom_state_header_kjr_reference"
              inherit_id="payment_custom.custom_state_header"
              name="KJR: Referenz statt Mitteilungen (Zahlungsstatus)">
        <xpath expr="//div[@id='o_payment_status_message_details']//strong" position="replace">
            <strong class="mt-auto">Referenz (Verwendungszweck): </strong>
        </xpath>
    </template>

    <!-- Einwilligung (kjr_event 19.0.5.9.0): Hinweis auf der Bestellbestaetigung,
         wenn Anmeldungen der Bestellung auf die Einwilligung der
         Erziehungsberechtigten warten. Ohne Adresse und ohne Namen.

         Anker: div#order_name aus website_sale.confirmation, derselbe Anker, an
         dem website_event_sale.event_confirmation die Veranstaltungskarten
         einfuegt. Mit hoeherer Prioritaet angewendet steht der Hinweis direkt
         unter der Bestellnummer und ueber den Karten. -->
    <template id="confirmation_kjr_consent_hint"
              inherit_id="website_sale.confirmation"
              priority="20"
              name="KJR: Hinweis Einwilligung auf der Bestellbestaetigung">
        <xpath expr="//div[@id='order_name']" position="after">
            <t t-set="held" t-value="order.order_line.registration_ids.filtered('kjr_consent_hold')"/>
            <div t-if="held" class="alert alert-info o_kjr_consent_hint" role="status">
                Für Teilnehmende unter 18 Jahren ist die Anmeldung erst verbindlich, wenn
                die Einwilligung der Erziehungsberechtigten vorliegt. Die Bitte um digitale
                Unterschrift senden wir per E-Mail.
            </div>
        </xpath>
    </template>

    <!-- Titelbild des Kurses statt Produktbild (das Ticket-Produkt hat meist
         keins, dann erschien nur ein grauer Platzhalter). -->
    <template id="cart_summary_content_kjr_event_image"
              inherit_id="website_sale.cart_summary_content"
              name="KJR: Kursbild in der Bestelluebersicht">
        <xpath expr="//td[hasclass('td-img')]/div[hasclass('o_cart_product_image')]/span[img[contains(@t-att-src, 'image_data_uri')]]" position="before">
            <t t-set="kjr_img" t-value="line._kjr_event_image_url()"/>
            <span t-if="kjr_img">
                <img t-att-src="kjr_img" class="img rounded" t-att-alt="line.name_short"
                     style="width:64px;height:64px;object-fit:cover;"/>
            </span>
        </xpath>
        <xpath expr="//td[hasclass('td-img')]/div[hasclass('o_cart_product_image')]/span[img[contains(@t-att-src, 'image_data_uri')]]" position="attributes">
            <attribute name="t-elif">not line._is_sellable() and line.product_id.image_128</attribute>
            <attribute name="t-if"/>
        </xpath>
    </template>

    <template id="cart_lines_kjr_event_image"
              inherit_id="website_sale.cart_lines"
              name="KJR: Kursbild im Warenkorb">
        <xpath expr="//div[hasclass('o_cart_product_image')]//img[contains(@t-att-src, 'image_data_uri')]" position="before">
            <t t-set="kjr_img" t-value="line._kjr_event_image_url()"/>
            <img t-if="kjr_img" t-att-src="kjr_img" class="img border rounded"
                 t-att-alt="line.name_short" style="width:64px;height:64px;object-fit:cover;"/>
        </xpath>
        <xpath expr="//div[hasclass('o_cart_product_image')]//img[contains(@t-att-src, 'image_data_uri')]" position="attributes">
            <attribute name="t-elif">not line._is_sellable() and line.product_id.image_128</attribute>
            <attribute name="t-if"/>
        </xpath>
    </template>

</odoo>
