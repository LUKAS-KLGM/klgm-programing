<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Suchansicht: ERSATZ FÜR DEN KAMERA-SCAN.
         Ein Handscanner tippt den gelesenen Code in das gerade aktive Eingabefeld.
         Landet er in der Suchzeile, muss die Standardsuche (Feld "name") deshalb
         zusätzlich Inventarnummer UND Barcode abdecken - sonst findet die
         Geschäftsstelle den gescannten Artikel nicht. -->
    <record id="view_kjr_rental_item_search" model="ir.ui.view">
        <field name="name">kjr.rental.item.search</field>
        <field name="model">kjr.rental.item</field>
        <field name="arch" type="xml">
            <search string="Verleihartikel">
                <field name="name" string="Artikel / Nummer / Barcode"
                       filter_domain="['|', '|', ('name', 'ilike', self), ('code', 'ilike', self), ('barcode', 'ilike', self)]"/>
                <field name="barcode" string="Barcode"/>
                <field name="code" string="Inventarnummer"/>
                <field name="category_id"/>
                <field name="location_id"/>
                <separator/>
                <filter string="Auf Website" name="published" domain="[('website_published','=',True)]"/>
                <filter string="Ohne Barcode" name="no_barcode"
                        domain="['|', ('barcode','=',False), ('barcode','=','')]"
                        help="Artikel, für die noch kein Inventaretikett vergeben wurde."/>
                <separator/>
                <filter string="Kategorie" name="group_category" context="{'group_by':'category_id'}"/>
                <filter string="Lager" name="group_location" context="{'group_by':'location_id'}"/>
            </search>
        </field>
    </record>

    <record id="view_kjr_rental_item_list" model="ir.ui.view">
        <field name="name">kjr.rental.item.list</field>
        <field name="model">kjr.rental.item</field>
        <field name="arch" type="xml">
            <list string="Verleihartikel">
                <!-- Mehrfachauswahl: Barcodes für alle markierten Artikel auf einmal
                     erzeugen, danach direkt über "Drucken > Inventaretikett" bekleben. -->
                <header>
                    <button name="action_generate_barcode" type="object"
                            string="Barcode erzeugen" icon="fa-barcode"
                            groups="kjr_rental.group_kjr_rental_user"/>
                </header>
                <field name="name"/>
                <field name="code" optional="hide"/>
                <!-- Standardmäßig ausgeblendet: nur für Etiketten-/Inventurarbeit relevant. -->
                <field name="barcode" optional="hide"/>
                <field name="category_id"/>
                <field name="location_id"/>
                <field name="quantity_total"/>
                <field name="price_per_day"/>
                <field name="price_member_per_day"/>
                <field name="deposit"/>
                <field name="book_value"/>
                <field name="website_published"/>
            </list>
        </field>
    </record>

    <record id="view_kjr_rental_item_form" model="ir.ui.view">
        <field name="name">kjr.rental.item.form</field>
        <field name="model">kjr.rental.item</field>
        <field name="arch" type="xml">
            <form string="Verleihartikel">
                <header>
                    <!-- Nur sichtbar, solange kein Etikett vergeben ist: die Methode
                         überschreibt vorhandene Barcodes bewusst nicht. -->
                    <button name="action_generate_barcode" type="object"
                            string="Barcode erzeugen" icon="fa-barcode"
                            invisible="barcode"
                            groups="kjr_rental.group_kjr_rental_user"/>
                </header>
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar"/>
                    <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
                    <group>
                        <group string="Einordnung">
                            <field name="code"/>
                            <field name="barcode" placeholder="z. B. KJR-BUS-01"/>
                            <field name="category_id"/>
                            <field name="location_id"/>
                            <field name="quantity_total"/>
                            <field name="icon"/>
                            <field name="website_published"/>
                        </group>
                        <group string="Tarife &amp; Kaution">
                            <field name="price_per_day"/>
                            <field name="has_member_price"/>
                            <field name="price_member_per_day" invisible="not has_member_price"/>
                            <field name="deposit"/>
                        </group>
                    </group>
                    <group string="Abschreibung (lineare Eigenberechnung)">
                        <group>
                            <field name="purchase_value"/>
                            <field name="purchase_date"/>
                        </group>
                        <group>
                            <field name="useful_life_years"/>
                            <field name="salvage_value"/>
                            <field name="book_value"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Beschreibung" name="description">
                            <field name="description" placeholder="Beschreibung..."/>
                        </page>
                        <page string="Nutzungshinweise" name="usage_warning">
                            <div class="text-muted mb-2">
                                Verbindliche Regeln für genau diesen Artikel. Der Text wird
                                dem Entleiher auf der Website vor dem Absenden der Anfrage
                                angezeigt und muss dort bestätigt werden.
                            </div>
                            <field name="usage_warning" nolabel="1"
                                   placeholder="z. B. Führerscheinklasse, Aufbau nur durch eingewiesene Personen, gereinigt zurückgeben..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_kjr_rental_item_kanban" model="ir.ui.view">
        <field name="name">kjr.rental.item.kanban</field>
        <field name="model">kjr.rental.item</field>
        <field name="arch" type="xml">
            <kanban default_group_by="category_id">
                <templates>
                    <t t-name="card">
                        <field name="icon" invisible="1"/>
                        <div class="d-flex">
                            <i t-if="record.icon.value" t-attf-class="fa #{record.icon.value} fa-2x me-2 text-primary" t-att-title="record.name.value"/>
                            <div>
                                <strong><field name="name"/></strong>
                                <div class="text-muted"><field name="location_id"/> · <field name="quantity_total"/> Stk.</div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_kjr_rental_item" model="ir.actions.act_window">
        <field name="name">Verleihartikel</field>
        <field name="res_model">kjr.rental.item</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="search_view_id" ref="view_kjr_rental_item_search"/>
    </record>

    <!-- Stammdaten: Kategorien (frei pflegbar) -->
    <record id="view_kjr_rental_category_list" model="ir.ui.view">
        <field name="name">kjr.rental.category.list</field>
        <field name="model">kjr.rental.category</field>
        <field name="arch" type="xml">
            <list string="Verleih-Kategorien" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="icon"/>
                <field name="item_count"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="action_kjr_rental_category" model="ir.actions.act_window">
        <field name="name">Verleih-Kategorien</field>
        <field name="res_model">kjr.rental.category</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Stammdaten: Lager (frei pflegbar) -->
    <record id="view_kjr_rental_location_list" model="ir.ui.view">
        <field name="name">kjr.rental.location.list</field>
        <field name="model">kjr.rental.location</field>
        <field name="arch" type="xml">
            <list string="Lager" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="action_kjr_rental_location" model="ir.actions.act_window">
        <field name="name">Lager</field>
        <field name="res_model">kjr.rental.location</field>
        <field name="view_mode">list</field>
    </record>

</odoo>
