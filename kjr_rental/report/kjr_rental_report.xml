<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_rental_contract" model="ir.actions.report">
        <field name="name">Verleihvertrag</field>
        <field name="model">kjr.rental.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">kjr_rental.rental_contract_template</field>
        <field name="report_file">kjr_rental.rental_contract_template</field>
        <field name="print_report_name">'Verleihvertrag_%s' % (object.name or '').replace('/', '-')</field>
        <field name="binding_model_id" ref="model_kjr_rental_order"/>
        <field name="binding_type">report</field>
        <field name="group_ids" eval="[(4, ref('kjr_rental.group_kjr_rental_user'))]"/>
    </record>

    <!-- Inventaretikett: Bogen mit mehreren Artikeln, aus der Listenauswahl
         heraus druckbar (binding_model_id). Struktur bewusst identisch zur
         Vertrags-Action oben. -->
    <record id="action_report_rental_label" model="ir.actions.report">
        <field name="name">Inventaretikett</field>
        <field name="model">kjr.rental.item</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">kjr_rental.report_rental_label</field>
        <field name="report_file">kjr_rental.report_rental_label</field>
        <field name="print_report_name">'Etikett_%s' % (object.code or object.name or '').replace('/', '-')</field>
        <field name="binding_model_id" ref="model_kjr_rental_item"/>
        <field name="binding_type">report</field>
        <field name="group_ids" eval="[(4, ref('kjr_rental.group_kjr_rental_user'))]"/>
    </record>

    <template id="report_rental_label">
        <t t-call="web.html_container">
            <t t-call="web.basic_layout">
                <div class="page">
                    <!--
                        Tabellenraster statt Flexbox: der PDF-Renderer bricht Tabellen
                        zeilenweise um, sodass mit page-break-inside:avoid nie ein
                        Etikett quer über den Seitenrand zerschnitten wird.
                        2 Etiketten je Zeile ≈ 90 mm Breite – passt auf handelsübliche
                        Bogenware und bleibt auch bei reinem A4-Druck brauchbar.
                    -->
                    <table style="width:100%; table-layout:fixed; border-collapse:separate; border-spacing:0;">
                        <tbody>
                            <tr t-foreach="list(range(0, len(docs), 2))" t-as="row_start"
                                style="page-break-inside:avoid;">
                                <td t-foreach="docs[row_start:row_start + 2]" t-as="o"
                                    style="width:50%; vertical-align:top; padding:2mm;">
                                    <div style="border:1px solid #999; border-radius:2mm; padding:3mm; height:42mm; overflow:hidden;">
                                        <div style="font-size:13pt; font-weight:bold; line-height:1.1;">
                                            <span t-field="o.name"/>
                                        </div>
                                        <div style="font-size:9pt; color:#444; margin-top:1mm;">
                                            Inv.-Nr.:
                                            <span t-if="o.code" t-field="o.code"/>
                                            <span t-else="">—</span>
                                            <t t-if="o.location_id">
                                                · <span t-field="o.location_id.name"/>
                                            </t>
                                        </div>
                                        <!-- Barcode über den Kern-Endpunkt aus dem Modul 'web'
                                             (ADR-1: keine Abhängigkeit zu 'stock').
                                             humanreadable=1 druckt den Wert zusätzlich als
                                             Klartext unter die Balken, damit er notfalls
                                             abgetippt werden kann. Erzeugte Barcodes enthalten
                                             nur A-Z, 0-9 und '-' und sind daher ohne Kodierung
                                             als URL-Pfad verwendbar.
                                             Ohne Wert lieferte der Endpunkt ein kaputtes Bild –
                                             deshalb der Hinweistext im t-else. -->
                                        <div style="text-align:center; margin-top:2mm;">
                                            <img t-if="o.barcode"
                                                 t-attf-src="/report/barcode/Code128/#{o.barcode}?width=560&amp;height=110&amp;humanreadable=1"
                                                 style="max-width:100%; height:auto;"
                                                 t-att-alt="o.barcode"/>
                                            <div t-else=""
                                                 style="font-size:9pt; color:#a00; border:1px dashed #a00; padding:3mm; margin-top:2mm;">
                                                Kein Barcode hinterlegt.<br/>
                                                Im Artikel über „Barcode erzeugen“ vergeben und erneut drucken.
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <!-- Ungerade Anzahl: leere Zelle, damit die letzte Zeile
                                     nicht auf volle Breite gedehnt wird. -->
                                <td t-if="row_start + 2 &gt; len(docs)" style="width:50%;"/>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>

    <template id="rental_contract_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h3 class="text-primary"><span t-field="o.company_id.name"/> — Materialverleih</h3>
                        <hr/>
                        <h4 class="text-center mb-4">Verleihvertrag <t t-esc="o.name"/></h4>
                        <p>
                            Entleiher: <strong><t t-esc="o.partner_id.name"/></strong><br/>
                            Zeitraum:
                            <span t-field="o.date_from" t-options='{"format":"dd.MM.yyyy"}'/> bis
                            <span t-field="o.date_to" t-options='{"format":"dd.MM.yyyy"}'/>
                            (<t t-esc="o.rental_days"/> Tage)
                        </p>
                        <!-- Der Vertrag wird vom Entleiher unterschrieben und muss deshalb
                             betraglich exakt dem Vorgang entsprechen.
                             * Beschriftung neutral "Einzelpreis": die Bezugsgröße hängt am
                               Preismodell des Artikels (Tag, Nacht, Stück, Grundgebühr,
                               Mengenstaffel) und steht je Zeile als Klartext darunter
                               (item.price_base_unit_label — NICHT price_unit_label: das
                               beschreibt beim Kilometermodell zwei Beträge auf einmal und
                               ist damit keine Einheit für die eine gedruckte Zahl).
                             * Gedruckt wird price_unit_effective — der TATSÄCHLICH angesetzte
                               Preis. price_per_day ist nur der Grundpreis und weicht bei der
                               Mengenstaffel vom berechneten Wert ab; der Vertrag hätte dort
                               eine andere Zahl ausgewiesen als die Summe. -->
                        <table class="table table-sm table-bordered">
                            <thead class="table-light">
                                <tr><th>Artikel</th><th class="text-end">Menge</th><th class="text-end">Berechnete Einheiten</th><th class="text-end">Einzelpreis</th><th class="text-end">Summe</th><th class="text-end">Kaution</th></tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.line_ids" t-as="line">
                                    <tr>
                                        <td>
                                            <t t-esc="line.item_id.name"/>
                                            <!-- Kilometermodell: die Fahrleistung wird erst bei der
                                                 Rückgabe abgelesen. Der Vertrag muss deshalb sagen,
                                                 dass zur Grundgebühr noch die gefahrenen Kilometer
                                                 kommen — sonst unterschreibt der Entleiher einen
                                                 Betrag, der noch steigen wird. -->
                                            <div t-if="line.pricing_model == 'per_km'" class="small text-muted">
                                                Zusätzlich wird nach gefahrenen Kilometern abgerechnet
                                                (<t t-esc="'%.2f €' % line.price_per_km"/> je km).
                                                <t t-if="line.distance_km">
                                                    Erfasst: <t t-esc="'%.1f' % line.distance_km"/> km
                                                    = <t t-esc="'%.2f €' % (line.price_per_km * line.distance_km)"/>.
                                                </t>
                                                <t t-else="">
                                                    Der Kilometerstand wird bei der Rückgabe abgelesen; die
                                                    Summe unten enthält bisher nur die Grundgebühr.
                                                </t>
                                            </div>
                                        </td>
                                        <td class="text-end"><t t-esc="line.quantity"/></td>
                                        <td class="text-end"><t t-esc="line.billable_units"/></td>
                                        <td class="text-end">
                                            <t t-esc="'%.2f €' % line.price_unit_effective"/>
                                            <div t-if="line.item_id.price_base_unit_label" class="small text-muted">
                                                <t t-esc="line.item_id.price_base_unit_label"/>
                                            </div>
                                        </td>
                                        <td class="text-end"><t t-esc="'%.2f €' % line.subtotal"/></td>
                                        <td class="text-end"><t t-esc="'%.2f €' % line.deposit_subtotal"/></td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <!-- Der Vertrag wird unterschrieben, die Rechnung entsteht separat.
                                     Deshalb muss hier stehen, worauf sich die Summe bezieht: Die
                                     Zeilenpreise sind ohne Umsatzsteuer erfasst; welcher Satz
                                     hinzukommt, entscheidet erst die Rechnung. -->
                                <tr class="fw-bold"><td colspan="4">Summe (ohne Umsatzsteuer)</td><td class="text-end"><t t-esc="'%.2f €' % o.amount_total"/></td><td class="text-end"><t t-esc="'%.2f €' % o.deposit_total"/></td></tr>
                            </tfoot>
                        </table>
                        <p class="small text-muted mt-3">
                            Der Entleiher haftet für Beschädigung/Verlust. Die Kaution wird bei
                            ordnungsgemäßer Rückgabe erstattet. Rückgabe spätestens am vereinbarten Datum.<br/>
                            Die oben ausgewiesene Summe versteht sich ohne Umsatzsteuer; ob und in
                            welcher Höhe Umsatzsteuer hinzukommt, ergibt sich aus der Rechnung.
                        </p>
                        <div class="row mt-5">
                            <div class="col-6"><div style="border-top:1px solid #000; width:220px; margin-top:40px; padding-top:4px;"><small>Entleiher (Datum, Unterschrift)</small></div></div>
                            <div class="col-6 text-end"><div style="border-top:1px solid #000; width:220px; margin-top:40px; padding-top:4px; margin-left:auto;"><small><span t-field="o.company_id.name"/></small></div></div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
