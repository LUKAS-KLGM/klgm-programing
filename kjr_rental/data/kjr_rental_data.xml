<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- White-Label: frei pflegbare Stammdaten (Kategorien/Lager) -->
        <!-- ICONS: Odoo 19 liefert FontAwesome 4.7.0 aus
             (addons/web/static/src/libs/fontawesome/css/font-awesome.css, Kopfzeile
             "Based on Font Awesome 4.7.0", Schriftdatei fontawesome-webfont.woff2?v=4.7.0).
             Hier gehoeren deshalb AUSSCHLIESSLICH FA-4-Klassen hinein. Die FA-5/6-Namen
             fa-futbol und fa-utensils existieren in 4.7.0 NICHT und rendern als leerer
             Kasten; richtig sind die FA-4-Namen fa-futbol-o und fa-cutlery. Jede neue
             Klasse vor dem Eintragen gegen die oben genannte CSS pruefen:
             grep -q "^\.KLASSENNAME:before" font-awesome.css -->
        <record id="cat_vehicle" model="kjr.rental.category"><field name="name">Fahrzeuge / Bus</field><field name="sequence">10</field><field name="icon">fa-bus</field></record>
        <!-- fa-bed statt fa-home: fa-home zeigt ein Haus und fuehrt bei Zelten in die
             Irre. Ein Zelt-/Camping-Glyph gibt es in FA 4.7.0 nicht (fa-tent und
             fa-campground: beide nicht vorhanden), fa-bed steht fuer Uebernachtungsmaterial. -->
        <record id="cat_tent" model="kjr.rental.category"><field name="name">Zelte</field><field name="sequence">20</field><field name="icon">fa-bed</field></record>
        <!-- fa-sliders statt fa-volume-up: der Lautstaerkeregler passt nur zur
             Beschallung, die Kategorie umfasst aber Ton UND Licht. fa-sliders zeigt
             Regler/Mischpult und deckt beides ab. -->
        <record id="cat_tech" model="kjr.rental.category"><field name="name">Technik</field><field name="sequence">30</field><field name="icon">fa-sliders</field></record>
        <record id="cat_sport" model="kjr.rental.category"><field name="name">Sport</field><field name="sequence">40</field><field name="icon">fa-futbol-o</field></record>
        <record id="cat_kitchen" model="kjr.rental.category"><field name="name">Küche</field><field name="sequence">50</field><field name="icon">fa-cutlery</field></record>
        <record id="cat_games" model="kjr.rental.category"><field name="name">Spielgeräte</field><field name="sequence">60</field><field name="icon">fa-puzzle-piece</field></record>
        <!-- fa-cube ergaenzt: "Sonstiges" war die einzige Kategorie ohne Icon, und die
             Katalogueberschrift zeichnet das Symbol nur bei gesetztem Icon
             (views/website_templates.xml, t-if="cat.icon"). fa-cube ist dasselbe
             Rueckfallsymbol, das die Artikelkachel ohnehin schon verwendet. -->
        <record id="cat_other" model="kjr.rental.category"><field name="name">Sonstiges</field><field name="sequence">99</field><field name="icon">fa-cube</field></record>
        <!-- Lagerorte: bewusst neutrale Platzhalter. Die echten Lagerorte sind
             Instanzdaten und werden in der Instanz unter Verleih > Lager gepflegt
             bzw. umbenannt; Ortsnamen eines einzelnen Betreibers gehoeren nicht in
             ein Modul, das an weitere Jugendringe ausgeliefert wird.
             Die XML-IDs tragen aus historischen Gruenden noch Ortsnamen und bleiben
             bewusst stehen: ein Umbenennen wuerde auf Bestandsinstanzen Dubletten
             erzeugen und die ref=-Verweise der Artikel unten brechen. -->
        <record id="loc_sonthofen" model="kjr.rental.location"><field name="name">Hauptlager</field><field name="sequence">10</field></record>
        <record id="loc_immenstadt" model="kjr.rental.location"><field name="name">Nebenlager</field><field name="sequence">20</field></record>
        <record id="loc_oberstdorf" model="kjr.rental.location"><field name="name">Außenlager</field><field name="sequence">30</field></record>

        <!-- Service-Produkte für Rechnungszeilen (Steuer-/Kontenfindung) -->
        <record id="product_rental_fee" model="product.product">
            <field name="name">Verleihgebühr</field>
            <field name="type">service</field>
            <field name="list_price">0.0</field>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="False"/>
        </record>
        <record id="product_rental_deposit" model="product.product">
            <field name="name">Kaution</field>
            <field name="type">service</field>
            <field name="list_price">0.0</field>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="False"/>
        </record>

        <!-- Konfigurierbare Schalter (Systemparameter) -->
        <record id="param_reserve_draft" model="ir.config_parameter">
            <field name="key">kjr_rental.reserve_draft</field>
            <field name="value">False</field>
        </record>
        <record id="param_auto_invoice_on_return" model="ir.config_parameter">
            <field name="key">kjr_rental.auto_invoice_on_return</field>
            <field name="value">False</field>
        </record>

        <!-- Die sechs Beispielartikel (9-Sitzer Bus, Gruppenzelt, PA-Anlage,
             Sportgeräte-Set, Feldküche, Großspielgeräte) standen bis 19.0.5.7.0 hier.
             Sie waren reine Vorführdaten mit erfundenen Preisen und Mitgliedstarifen und
             erschienen auf Bestandsinstanzen im öffentlichen Katalog (Rückmeldung des
             Betreibers vom 14.10.2026: es gibt nur einen Bus und keine Mitgliedspreise).
             Neuinstallationen bekommen sie nicht mehr; Bestandsinstanzen räumt
             migrations/19.0.5.8.0/post-migration.py auf. Artikel pflegt der Betreiber
             selbst unter Verleih > Artikel. -->
        <!-- Spielmobil: eigenes Angebot mit eigener Landingpage (/service/spielmobil).
             Steht wie alle Seed-Daten unter noupdate="1" - der Datensatz wird beim
             Upgrade EINMAL angelegt und danach nie wieder überschrieben, die
             Geschäftsstelle kann ihn also gefahrlos anpassen.
             TODO Betreiber: Tagespreis und Kaution sind Platzhalter
             (0,00 €) und müssen vom Betreiber bestätigt werden. Solange sie unbestätigt
             sind, ist der Artikel bewusst NICHT auf der Website veröffentlicht
             (website_published = False), damit online keine falschen Preise stehen.
             Nach der Freigabe: Preise eintragen und "Auf Website" aktivieren. -->
        <record id="item_spielmobil" model="kjr.rental.item">
            <field name="name">Spielmobil</field><field name="category_id" ref="cat_games"/>
            <field name="location_id" ref="loc_sonthofen"/><field name="quantity_total">1</field>
            <field name="price_per_day">0.0</field>
            <field name="deposit">0.0</field><field name="icon">fa-truck</field>
            <field name="website_published" eval="False"/>
            <field name="description">Mobile Spiel- und Aktionsausstattung für Ferienprogramme, Stadtteilfeste und Gruppenaktionen. Wird komplett bestückt übergeben.</field>
            <field name="usage_warning"><![CDATA[<ul>
    <li>Abholung und Rückgabe nur nach vorheriger Einweisung durch die Geschäftsstelle.</li>
    <li>Führen des Anhängers nur mit gültiger Fahrerlaubnis der passenden Klasse.</li>
    <li>Aufbau und Betreuung ausschließlich durch volljährige, eingewiesene Personen.</li>
    <li>Nutzung nur im Rahmen von Jugend- und Bildungsarbeit.</li>
    <li>Vollständig, gereinigt und trocken zurückgeben; Schäden sofort melden.</li>
</ul>]]></field>
        </record>

        <!-- Der DSGVO-Cron "cron_kjr_rental_anonymize" stand bis 21.08.2026 hier.
             Er ist nach data/ir_cron_data.xml umgezogen, weil __manifest__.py diese
             Datei inzwischen laedt und dieselbe XML-ID sonst in zwei Dateien
             desselben Moduls definiert waere. Fachlich hat sich nichts geaendert. -->
    </data>
</odoo>
