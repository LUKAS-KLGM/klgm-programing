<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- White-Label: frei pflegbare Stammdaten (Kategorien/Lager) -->
        <record id="cat_vehicle" model="kjr.rental.category"><field name="name">Fahrzeuge / Bus</field><field name="sequence">10</field><field name="icon">fa-bus</field></record>
        <record id="cat_tent" model="kjr.rental.category"><field name="name">Zelte</field><field name="sequence">20</field><field name="icon">fa-home</field></record>
        <record id="cat_tech" model="kjr.rental.category"><field name="name">Technik</field><field name="sequence">30</field><field name="icon">fa-volume-up</field></record>
        <record id="cat_sport" model="kjr.rental.category"><field name="name">Sport</field><field name="sequence">40</field><field name="icon">fa-futbol-o</field></record>
        <record id="cat_kitchen" model="kjr.rental.category"><field name="name">Küche</field><field name="sequence">50</field><field name="icon">fa-cutlery</field></record>
        <record id="cat_games" model="kjr.rental.category"><field name="name">Spielgeräte</field><field name="sequence">60</field><field name="icon">fa-puzzle-piece</field></record>
        <record id="cat_other" model="kjr.rental.category"><field name="name">Sonstiges</field><field name="sequence">99</field></record>
        <record id="loc_sonthofen" model="kjr.rental.location"><field name="name">Lager Sonthofen</field><field name="sequence">10</field></record>
        <record id="loc_immenstadt" model="kjr.rental.location"><field name="name">Lager Immenstadt</field><field name="sequence">20</field></record>
        <record id="loc_oberstdorf" model="kjr.rental.location"><field name="name">Lager Oberstdorf</field><field name="sequence">30</field></record>

        <!-- Service-Produkte für Rechnungszeilen (Steuer-/Kontenfindung) -->
        <record id="product_rental_fee" model="product.product">
            <field name="name">Verleihgebühr</field>
            <field name="type">service</field>
            <field name="list_price">0.0</field>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="False"/>
        </record>
        <record id="product_rental_deposit" model="product.product">
            <field name="name">Kaution</field>
            <field name="type">service</field>
            <field name="list_price">0.0</field>
            <field name="sale_ok" eval="True"/>
            <field name="purchase_ok" eval="False"/>
        </record>

        <!-- Konfigurierbare Schalter (Systemparameter) -->
        <record id="param_reserve_draft" model="ir.config_parameter">
            <field name="key">kjr_rental.reserve_draft</field>
            <field name="value">False</field>
        </record>
        <record id="param_auto_invoice_on_return" model="ir.config_parameter">
            <field name="key">kjr_rental.auto_invoice_on_return</field>
            <field name="value">False</field>
        </record>

        <!-- ── Beispiel-Verleihartikel ────────────────────────────────────
             ACHTUNG PREISE: Für die folgenden Artikel ist in den Unterlagen des KJR
             KEIN Preis belegt. Geprüft am 18.08.2026 gegen den Vault:
             "08 Kundenprojekte/01 KJR Oberallgäu/KJR-Website-Inhalte/04d_Verleih/
             INHALT.md" (die vollständige Verleih-Preisliste der Live-Seite) und
             "KJR Website - Ist-Zustand 2026-08-17.md", Abschnitt 5 ("Verleih") —
             dort steht ausdrücklich, dass 9-Sitzer Bus, Gruppenzelt, Feldküche,
             Sportgeräte-Set und PA-Anlage gegenüber der Live-Seite ZUSÄTZLICH
             angelegt wurden. Auch Großspielgeräte (Kubb, Twister XXL) kommen in der
             Preisliste nicht vor, und Kautionen nennt keine der Quellen.
             Die früher hier hinterlegten Tages-, Mitglieds- und Kautionsbeträge waren
             also frei erfunden und stehen jetzt auf 0,00 €. Ein Preis von 0,00 € fällt
             in der Pflege auf, eine erfundene Zahl von 60,00 € nicht.
             Zusätzlich stehen die Artikel auf website_published=False (Feld-Default
             wäre True): es sind Beispieldaten, die ohne bestätigte Preise nicht im
             öffentlichen Katalog unter /service/verleih erscheinen dürfen.
             TODO(KJR): echte Preise und Kautionen eintragen, danach "Auf Website"
             aktivieren. -->
        <!-- TODO(KJR): Die Preisliste (04d_Verleih/INHALT.md, Abschnitt "Fahrzeuge")
             kennt einen "Kleinbus 9-Sitzer" zu "bis 100 km: 35 € · ab 100 km:
             0,35 €/km". Dieser Staffeltarif lässt sich mit den vorhandenen Feldern
             NICHT korrekt abbilden: das Preismodell "Grundgebühr + Kilometerpreis"
             rechnet den Kilometersatz ab dem ersten Kilometer, ein Freikilometer-
             Kontingent gibt es nicht. Die Zahlen sind deshalb bewusst NICHT
             eingetragen, damit keine zu hohe Rechnung entsteht. Mitgliedspreis und
             Kaution sind für das Fahrzeug ohnehin nirgends belegt. -->
        <record id="item_bus" model="kjr.rental.item">
            <field name="name">9-Sitzer Bus</field><field name="category_id" ref="cat_vehicle"/>
            <field name="location_id" ref="loc_sonthofen"/><field name="quantity_total">1</field>
            <field name="price_per_day">0.0</field><field name="price_member_per_day">0.0</field>
            <field name="deposit">0.0</field><field name="icon">fa-bus</field>
            <field name="website_published" eval="False"/>
        </record>
        <record id="item_tent" model="kjr.rental.item">
            <field name="name">Gruppenzelt (10 Pers.)</field><field name="category_id" ref="cat_tent"/>
            <field name="location_id" ref="loc_sonthofen"/><field name="quantity_total">4</field>
            <field name="price_per_day">0.0</field><field name="price_member_per_day">0.0</field>
            <field name="deposit">0.0</field><field name="icon">fa-home</field>
            <field name="website_published" eval="False"/>
        </record>
        <record id="item_pa" model="kjr.rental.item">
            <field name="name">PA-Anlage</field><field name="category_id" ref="cat_tech"/>
            <field name="location_id" ref="loc_immenstadt"/><field name="quantity_total">2</field>
            <field name="price_per_day">0.0</field><field name="price_member_per_day">0.0</field>
            <field name="deposit">0.0</field><field name="icon">fa-volume-up</field>
            <field name="website_published" eval="False"/>
        </record>
        <record id="item_balls" model="kjr.rental.item">
            <field name="name">Sportgeräte-Set</field><field name="category_id" ref="cat_sport"/>
            <field name="location_id" ref="loc_oberstdorf"/><field name="quantity_total">6</field>
            <field name="price_per_day">0.0</field><field name="price_member_per_day">0.0</field>
            <field name="deposit">0.0</field><field name="icon">fa-futbol-o</field>
            <field name="website_published" eval="False"/>
        </record>
        <record id="item_kitchen" model="kjr.rental.item">
            <field name="name">Feldküche</field><field name="category_id" ref="cat_kitchen"/>
            <field name="location_id" ref="loc_sonthofen"/><field name="quantity_total">2</field>
            <field name="price_per_day">0.0</field><field name="price_member_per_day">0.0</field>
            <field name="deposit">0.0</field><field name="icon">fa-cutlery</field>
            <field name="website_published" eval="False"/>
        </record>
        <!-- Spielmobil: eigenes Angebot mit eigener Landingpage (/service/spielmobil).
             Steht wie alle Seed-Daten unter noupdate="1" - der Datensatz wird beim
             Upgrade EINMAL angelegt und danach nie wieder überschrieben, die
             Geschäftsstelle kann ihn also gefahrlos anpassen.
             TODO KJR: Tagespreis, Mitgliedspreis und Kaution sind Platzhalter (0,00 €)
             und müssen vom Kreisjugendring bestätigt werden. Solange sie unbestätigt
             sind, ist der Artikel bewusst NICHT auf der Website veröffentlicht
             (website_published = False), damit online keine falschen Preise stehen.
             Nach der Freigabe: Preise eintragen und "Auf Website" aktivieren. -->
        <record id="item_spielmobil" model="kjr.rental.item">
            <field name="name">Spielmobil</field><field name="category_id" ref="cat_games"/>
            <field name="location_id" ref="loc_sonthofen"/><field name="quantity_total">1</field>
            <field name="price_per_day">0.0</field><field name="price_member_per_day">0.0</field>
            <field name="deposit">0.0</field><field name="icon">fa-truck</field>
            <field name="website_published" eval="False"/>
            <field name="description">Mobile Spiel- und Aktionsausstattung für Ferienprogramme, Stadtteilfeste und Gruppenaktionen. Wird komplett bestückt übergeben.</field>
            <field name="usage_warning"><![CDATA[<ul>
    <li>Abholung und Rückgabe nur nach vorheriger Einweisung durch die Geschäftsstelle.</li>
    <li>Führen des Anhängers nur mit gültiger Fahrerlaubnis der passenden Klasse.</li>
    <li>Aufbau und Betreuung ausschließlich durch volljährige, eingewiesene Personen.</li>
    <li>Nutzung nur im Rahmen von Jugend- und Bildungsarbeit.</li>
    <li>Vollständig, gereinigt und trocken zurückgeben; Schäden sofort melden.</li>
</ul>]]></field>
        </record>

        <record id="item_games" model="kjr.rental.item">
            <field name="name">Großspielgeräte (Kubb, Twister XXL)</field><field name="category_id" ref="cat_games"/>
            <field name="location_id" ref="loc_immenstadt"/><field name="quantity_total">5</field>
            <field name="price_per_day">0.0</field><field name="price_member_per_day">0.0</field>
            <field name="deposit">0.0</field><field name="icon">fa-puzzle-piece</field>
            <field name="website_published" eval="False"/>
        </record>

        <!-- Der DSGVO-Cron "cron_kjr_rental_anonymize" stand bis 21.08.2026 hier.
             Er ist nach data/ir_cron_data.xml umgezogen, weil __manifest__.py diese
             Datei inzwischen laedt und dieselbe XML-ID sonst in zwei Dateien
             desselben Moduls definiert waere. Fachlich hat sich nichts geaendert. -->
    </data>
</odoo>
