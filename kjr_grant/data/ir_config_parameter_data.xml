<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate="1": Default-Werte; vom Administrator pflegbar, bei Updates nicht überschrieben. -->
    <data noupdate="1">

        <!-- Verzugszinsen: Basiszinssatz (§ 247 BGB) – halbjährlich pflegen (kann negativ sein) -->
        <record id="param_base_interest_rate" model="ir.config_parameter">
            <field name="key">kjr_grant.base_interest_rate</field>
            <field name="value">0.0</field>
        </record>
        <!-- Zuschlag auf den Basiszinssatz: bayerisch + 3 Prozentpunkte
             (ANBest-P Nr. 8.4 i. V. m. Art. 49a Abs. 3 BayVwVfG) -->
        <record id="param_interest_surcharge" model="ir.config_parameter">
            <field name="key">kjr_grant.default_interest_surcharge</field>
            <field name="value">3.0</field>
        </record>

        <!-- ══ DSGVO: Aufbewahrungsfristen ══════════════════════════════════
             Basisfrist. Sie steuert die Anonymisierung der Teilnehmerdaten
             (kjr.grant.participant) UND – als Rückfallwert – die Bereinigung der
             Nebenschauplätze am Antrag: hochgeladene Dateien, Feldhistorie
             (mail.tracking.value, u. a. IBAN) und Chatter. Belegter Anker für
             die 5 Jahre: ANBest-P Nr. 6.6.

             Warum Rückfallwert und kein zweiter Schalter: Wird der strukturierte
             Teilnehmerdatensatz anonymisiert, während dieselbe Namensliste als
             PDF-Anhang und in der Feldhistorie stehen bleibt, entsteht eine
             Sicherheit, die es nicht gibt. Beides läuft deshalb mit derselben
             Frist, sofern für eine Belegklasse unten nichts anderes gepflegt ist.

             TODO(KJR): Frist bestätigen bzw. festlegen.
             TODO(DSGVO): Durch die Datenschutzbeauftragte bestätigen lassen. -->
        <record id="param_retention_years" model="ir.config_parameter">
            <field name="key">kjr_grant.participant_retention_years</field>
            <field name="value">5</field>
        </record>

        <!-- Belegklassen mit eigener, im Vault BELEGTER Frist. Nur diese beiden
             werden ausgeliefert; alle übrigen Klassen (Teilnahmeliste, sonstige
             Anhänge, Feldhistorie, Chatter) haben bewusst keinen eigenen
             Parameter und folgen damit automatisch der Basisfrist oben. Ein hier
             oder dort eingetragener Wert 0 schaltet die jeweilige Klasse ab.
             Die Zuordnung Datei → Klasse erfolgt über den Dateinamen
             (DSGVO_ATTACHMENT_KEYWORDS in models/kjr_grant_application.py). -->

        <!-- Maßnahmenberichte / Verwendungsnachweise: 5 Jahre (ANBest-P Nr. 6.6).
             TODO(KJR): Frist bestätigen. -->
        <record id="param_retention_years_report" model="ir.config_parameter">
            <field name="key">kjr_grant.retention_years_report</field>
            <field name="value">5</field>
        </record>
        <!-- Am Antrag hochgeladene Belegliste / Rechnungen / Quittungen:
             8 Jahre (§ 147 AO, § 257 HGB) – bewusst länger als die Basisfrist,
             damit hier nichts zu früh durch einen Platzhalter ersetzt wird.
             ACHTUNG: Betrifft ausschließlich die Datei-Anhänge AM ANTRAG. Die
             gebuchten Belege in 'account' (account.move / account.payment) rührt
             die Routine wegen der Hash-Verkettung grundsätzlich nicht an.
             TODO(KJR): Frist bestätigen. -->
        <record id="param_retention_years_receipt" model="ir.config_parameter">
            <field name="key">kjr_grant.retention_years_receipt</field>
            <field name="value">8</field>
        </record>

        <!-- § 4.9 Delegiertenförderung: Sätze nach Bayer. Reisekostengesetz (BayRKG) -->
        <record id="param_bayrkg_rate_per_km" model="ir.config_parameter">
            <field name="key">kjr_grant.bayrkg_rate_per_km</field>
            <field name="value">0.35</field>
        </record>
        <record id="param_bayrkg_passenger_rate" model="ir.config_parameter">
            <field name="key">kjr_grant.bayrkg_passenger_rate_per_km</field>
            <field name="value">0.03</field>
        </record>

        <!-- Vier-Augen-Prinzip: '1' = an (Default, kassenrechtlich sauber).
             Ein-Personen-Geschäftsstelle kann hier auf '0' stellen; der Code
             nimmt bei fehlendem Parameter ebenfalls '1' an. -->
        <record id="param_enforce_four_eyes" model="ir.config_parameter">
            <field name="key">kjr_grant.enforce_four_eyes</field>
            <field name="value">1</field>
        </record>

        <!-- Auszahlungs-Stichtag (KJR-OA: 15.11.) – Anträge bis dahin im selben Jahr -->
        <record id="param_payout_cutoff_day" model="ir.config_parameter">
            <field name="key">kjr_grant.payout_cutoff_day</field>
            <field name="value">15</field>
        </record>
        <record id="param_payout_cutoff_month" model="ir.config_parameter">
            <field name="key">kjr_grant.payout_cutoff_month</field>
            <field name="value">11</field>
        </record>


        <!-- Rubriken, die bei der Installation auf der Portalseite „Mein Konto"
             ausgeblendet werden (kommagetrennte External IDs). Leer = die im
             Code hinterlegte Vorgabe gilt, siehe hooks.py.
             Greift nur bei der INSTALLATION; eine später von Hand wieder
             eingeblendete Rubrik bleibt sichtbar.
             TODO(KJR): nach dem ersten Deployment im Log prüfen, welche
             Einträge tatsächlich gefunden wurden, und die Liste bereinigen. -->
        <record id="param_portal_hidden_entries" model="ir.config_parameter">
            <field name="key">kjr_grant.portal_hidden_entries</field>
            <field name="value"></field>
        </record>
    </data>
</odoo>
