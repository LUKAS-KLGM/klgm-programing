<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Der Schlüssel auth_signup.allow_uninvited wird in Odoo 19 nicht gelesen.
             Maßgeblich ist website.auth_signup_uninvited (website/models/res_users.py:65-68);
             website_sale setzt ihn auf b2c (website_sale/models/website.py:88, __init__.py:15).
             Datensatz bleibt (noupdate, wirkungslos). -->
        <record id="auth_signup_uninvited" model="ir.config_parameter">
            <field name="key">auth_signup.allow_uninvited</field>
            <field name="value">True</field>
        </record>
    </data>
</odoo>
