<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_kjr_funding_list" model="ir.ui.view">
        <field name="name">kjr.funding.list</field>
        <field name="model">kjr.funding</field>
        <field name="arch" type="xml">
            <list decoration-danger="state == 'rejected'" decoration-success="state in ('approved','running')">
                <field name="name"/>
                <field name="funder"/>
                <field name="project_name"/>
                <field name="amount_requested" string="Beantragt (€)"/>
                <field name="amount_approved" string="Bewilligt (€)"/>
                <field name="deadline"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>
    <record id="view_kjr_funding_form" model="ir.ui.view">
        <field name="name">kjr.funding.form</field>
        <field name="model">kjr.funding</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_submit" string="Eingereicht" type="object"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_approve" string="Bewilligt" type="object"
                            class="btn-success" invisible="state != 'submitted'"/>
                    <button name="action_reject" string="Abgelehnt" type="object"
                            invisible="state != 'submitted'"/>
                    <button name="action_start" string="Laufend" type="object"
                            invisible="state != 'approved'"/>
                    <button name="action_close" string="Abschließen" type="object"
                            invisible="state not in ('approved','running')"/>
                    <button name="action_reset_draft" string="Zurück auf Entwurf" type="object"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,running,closed"/>
                </header>
                <sheet>
                    <group>
                        <group string="Förderprogramm">
                            <field name="name"/>
                            <field name="funder"/>
                            <field name="funder_name" invisible="funder not in ('stiftung','other')"/>
                            <field name="deadline"/>
                            <field name="responsible_id"/>
                        </group>
                        <group string="Finanzen">
                            <field name="amount_requested"/>
                            <field name="amount_approved"/>
                        </group>
                    </group>
                    <group>
                        <group string="Projekt">
                            <field name="project_name"/>
                            <field name="project_start"/>
                            <field name="project_end"/>
                            <field name="verwendungsnachweis_deadline"/>
                        </group>
                    </group>
                    <field name="project_description" placeholder="Projektbeschreibung..."/>
                    <field name="note" placeholder="Anmerkungen..."/>
                    <notebook>
                        <page string="Förderabrechnung (Export)" name="bezjr_export">
                            <div class="alert alert-info" role="alert">
                                Erzeugt die zeilenweise Aufstellung der geförderten
                                Maßnahmen als CSV (Semikolon, UTF-8 mit BOM, in Excel
                                direkt lesbar) für die Abrechnung mit dem Fördergeber.
                                <br/>
                                <b>Hinweis:</b> Die Spaltenstruktur ist eine
                                nachvollziehbare Aufstellung aus den Daten dieser
                                Anwendung und keine Nachbildung eines amtlichen
                                Vordrucks. Vor der ersten Abgabe bitte mit dem
                                Bezirksjugendring abstimmen.
                            </div>
                            <group>
                                <group string="Zeitraum">
                                    <field name="export_date_from"/>
                                    <field name="export_date_to"/>
                                    <field name="export_date_basis"/>
                                </group>
                                <group string="Umfang">
                                    <field name="export_state"/>
                                    <field name="export_layout"/>
                                    <field name="funding_source_code"
                                           placeholder="z. B. Aktenzeichen des Zuwendungsbescheids"/>
                                </group>
                            </group>
                            <group string="Abgrenzung der Maßnahmen">
                                <field name="export_grant_type_ids" widget="many2many_tags"
                                       options="{'no_create': True}"/>
                                <field name="export_analytic_account_id"
                                       options="{'no_create': True}"/>
                            </group>
                            <div class="mt16 mb16">
                                <button name="action_export_bezjr" type="object"
                                        string="Förderabrechnung erzeugen"
                                        class="btn-primary" icon="fa-download"/>
                            </div>
                            <group string="Zuletzt erzeugte Abrechnung"
                                   invisible="not export_filename">
                                <field name="export_file" filename="export_filename"
                                       readonly="1"/>
                                <field name="export_filename" readonly="1"/>
                                <field name="export_date" readonly="1"/>
                                <field name="export_line_count" readonly="1"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_kjr_funding" model="ir.actions.act_window">
        <field name="name">Fördermittel-Akquise</field>
        <field name="res_model">kjr.funding</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
