<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Eigene Einstellungen („Mein Profil“ / Einstellungen) -->
    <record id="view_users_form_simple_modif_kjr_activity_popup" model="ir.ui.view">
        <field name="name">res.users.preferences.form.kjr_activity_popup</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='other_preferences']" position="inside">
                <field name="kjr_activity_popup_enabled" readonly="0"/>
            </xpath>
        </field>
    </record>

    <!-- Benutzerverwaltung (Administration), Reiter Präferenzen -->
    <record id="view_users_form_kjr_activity_popup" model="ir.ui.view">
        <field name="name">res.users.form.kjr_activity_popup</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='other_preferences']" position="inside">
                <field name="kjr_activity_popup_enabled" invisible="share"/>
            </xpath>
        </field>
    </record>
</odoo>
